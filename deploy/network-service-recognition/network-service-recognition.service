[Unit]
Description=Background Materialized Service Intelligence (NI-04)
After=network-metadata-projection.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/CaptivePortal
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
EnvironmentFile=-/etc/captive-portal/network-service-recognition.env
ExecStart=/usr/bin/python3 -m app.network_service_recognition.cli run
Restart=on-failure
RestartSec=30
TimeoutStopSec=40
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/CaptivePortal/data
UMask=0027

[Install]
WantedBy=multi-user.target
