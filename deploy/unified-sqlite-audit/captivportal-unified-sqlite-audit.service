# CANDIDATE ONLY: do not install/enable/start without separate Owner/SysAdmin GO.
# Installation metadata only. NO enable/install/start by Coder; no timer/daemon.
[Unit]
Description=Optional once-per-portal-run serial RAM SQLite audit
After=captive-portal.service
Requisite=captive-portal.service
PartOf=captive-portal.service

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/opt/CaptivePortal
EnvironmentFile=/etc/default/captive-portal
# SysAdmin supplies this explicit root-owned current-run policy path through the
# effective portal environment. Empty/unset => no qualification, zero DB opens.
ExecStart=/usr/bin/python3 -m app.unified_sqlite_audit.cli run-once --wait-ready-seconds=60 --qualifications=${SQLITE_UNIFIED_AUDIT_QUALIFICATIONS}
RemainAfterExit=yes
TimeoutStartSec=infinity
TimeoutStopSec=10s
KillMode=control-group
SendSIGKILL=yes
MemoryMax=512M
MemorySwapMax=0
TasksMax=4
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
UMask=0077
# SysAdmin must pre-provision this protected directory. No source writes.
ReadWritePaths=/run/captiveportal-unified-sqlite-audit
StandardOutput=null
StandardError=journal

[Install]
# Owner/SysAdmin enable creates captive-portal.service.wants/ binding. Not done here.
WantedBy=captive-portal.service
