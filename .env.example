# Omada OpenAPI (required)
# CaptivePortal does not load this file automatically. Supply these values
# through the process environment or an approved secret mechanism.
OMADA_URL=
OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_WEBHOOK_SITE_ID_MAP_JSON={}

# Authorized Client Snapshot Collector.
# CaptivePortal does not load this file automatically; production values
# are supplied by the process environment or systemd.
VISITOR_SNAPSHOT_ENABLED=false
VISITOR_SNAPSHOT_LOG_FILE=/opt/CaptivePortal/logs/visitor_snapshots.log
VISITOR_SNAPSHOT_MAX_WORKERS=2
VISITOR_SNAPSHOT_MAX_PENDING=100
VISITOR_SNAPSHOT_MAX_JOB_AGE_SECONDS=30
VISITOR_SNAPSHOT_REQUEST_TIMEOUT_SECONDS=5
VISITOR_SNAPSHOT_RETRY_DELAYS_SECONDS=2,5
VISITOR_SNAPSHOT_ROTATION_MAX_BYTES=52428800
VISITOR_SNAPSHOT_ROTATION_BACKUP_COUNT=20
VISITOR_SNAPSHOT_SHUTDOWN_TIMEOUT_SECONDS=90

# Visitor Device Registry
# Keep disabled until the Registry receives separate production approval.
VISITOR_REGISTRY_ENABLED=false
VISITOR_REGISTRY_DB_PATH=/opt/CaptivePortal/data/visitor_registry.sqlite3
VISITOR_REGISTRY_SCAN_INTERVAL_SECONDS=5
VISITOR_REGISTRY_SHUTDOWN_TIMEOUT_SECONDS=10
VISITOR_REGISTRY_MAX_LINE_BYTES=4194304

# Visit Lifecycle v1. Keep disabled until a separate production activation.
VISIT_LIFECYCLE_ENABLED=false
VISIT_LIFECYCLE_DB_PATH=/opt/CaptivePortal/data/visits.sqlite3
VISIT_LIFECYCLE_WEBHOOK_SOURCE=/opt/CaptivePortal/logs/omada_webhook_normalized.log
VISIT_LIFECYCLE_SCAN_INTERVAL_SECONDS=5
VISIT_LIFECYCLE_RECONCILE_INTERVAL_SECONDS=30
VISIT_LIFECYCLE_MAX_LINE_BYTES=1048576
VISIT_LIFECYCLE_READER_MAX_LINES_PER_SCAN=5000
VISIT_LIFECYCLE_READER_MAX_BYTES_PER_SCAN=16777216
VISIT_LIFECYCLE_READER_MAX_DURATION_SECONDS=20
VISIT_LIFECYCLE_RECONCILE_BATCH_SIZE=500
VISIT_LIFECYCLE_PENDING_OFFLINE_BATCH_SIZE=500
VISIT_LIFECYCLE_OFFLINE_MATCH_GRACE_SECONDS=30
VISIT_LIFECYCLE_START_WRITER_SLOT_WAIT_MS=750
VISIT_LIFECYCLE_READER_WRITER_SLOT_WAIT_MS=250
VISIT_LIFECYCLE_RECONCILIATION_WRITER_SLOT_WAIT_MS=250
VISIT_LIFECYCLE_SQLITE_BUSY_TIMEOUT_MS=500
VISIT_LIFECYCLE_START_MAX_ATTEMPTS=3
VISIT_LIFECYCLE_START_TOTAL_BUDGET_MS=2000
# Deprecated alias used only when START_WRITER_SLOT_WAIT_MS is absent:
# VISIT_LIFECYCLE_START_BUSY_TIMEOUT_MS=750
VISIT_LIFECYCLE_SHUTDOWN_TIMEOUT_SECONDS=20
VISIT_LIFECYCLE_MAX_OFFLINE_CLOCK_SKEW_SECONDS=120
VISIT_LIFECYCLE_MAX_REPORTED_DURATION_DRIFT_SECONDS=300

# Observation Storage Foundation
# Client/AP collectors, storage, queries and cleanup. Keep disabled until a separate
# production activation task is approved.
OBSERVATION_FOUNDATION_ENABLED=false
OBSERVATION_DB_PATH=/opt/CaptivePortal/data/observations.sqlite3
OBSERVATION_DYNAMIC_RETENTION_DAYS=180
OBSERVATION_CONFIG_RETENTION_DAYS=730
OBSERVATION_CLEANUP_INITIAL_DELAY_SECONDS=900
OBSERVATION_CLEANUP_INTERVAL_SECONDS=86400
OBSERVATION_CLEANUP_BATCH_SIZE=5000
OBSERVATION_CLEANUP_MAX_DURATION_SECONDS=30
OBSERVATION_SHUTDOWN_TIMEOUT_SECONDS=20
OBSERVATION_CLIENT_ENABLED=true
OBSERVATION_SITE_IDS=
OBSERVATION_CLIENT_SSIDS=
OBSERVATION_CLIENT_INITIAL_DELAY_SECONDS=15
OBSERVATION_CLIENT_INTERVAL_SECONDS=60
OBSERVATION_CLIENT_PAGE_SIZE=500
OBSERVATION_CLIENT_MAX_PAGES=20
OBSERVATION_CLIENT_MAX_ROWS=10000
OBSERVATION_AP_ENABLED=true
OBSERVATION_AP_INITIAL_DELAY_SECONDS=10
OBSERVATION_AP_INTERVAL_SECONDS=30
OBSERVATION_AP_INVENTORY_INTERVAL_SECONDS=300
OBSERVATION_AP_INVENTORY_MAX_STALE_SECONDS=900
OBSERVATION_AP_CONFIG_INTERVAL_SECONDS=21600
OBSERVATION_REQUEST_TIMEOUT_SECONDS=5
OBSERVATION_AP_PAGE_SIZE=100
OBSERVATION_AP_MAX_PAGES=10
OBSERVATION_AP_MAX_ROWS=500
OBSERVATION_AP_DYNAMIC_MAX_REQUESTS_PER_CYCLE=200
OBSERVATION_AP_CONFIG_MAX_REQUESTS_PER_CYCLE=200
OBSERVATION_AP_CYCLE_MAX_DURATION_SECONDS=120
OBSERVATION_AP_CONFIG_CYCLE_MAX_DURATION_SECONDS=180
OBSERVATION_RATE_MAX_GAP_SECONDS=180

# Analytics read-only foundation and internal operator API.
# Keep disabled until a separate owner-controlled production activation.
ANALYTICS_FOUNDATION_ENABLED=false
ANALYTICS_WIRELESS_ENABLED=true
ANALYTICS_VISIT_ENABLED=true
ANALYTICS_DEFAULT_LIMIT=500
ANALYTICS_MAX_LIMIT=2000
ANALYTICS_MAX_QUERY_WINDOW_DAYS=31
ANALYTICS_MAX_QUERY_DURATION_SECONDS=10
ANALYTICS_QUALITY_GAP_THRESHOLD_SECONDS=180
ANALYTICS_WIRELESS_MIN_SAMPLES=20
ANALYTICS_WIRELESS_MAX_WINDOW_DAYS=7
ANALYTICS_COUNTER_MAX_GAP_SECONDS=180
ANALYTICS_AP_JOIN_MAX_LAG_SECONDS=120
ANALYTICS_RSSI_THRESHOLD_DBM=
ANALYTICS_SNR_THRESHOLD_DB=
ANALYTICS_VISIT_MIN_COHORT_SIZE=20
ANALYTICS_VISIT_MAX_WINDOW_DAYS=90
ANALYTICS_API_ENABLED=false
# Generate and inject the production token outside Git during activation.
ANALYTICS_API_BEARER_TOKEN=
ANALYTICS_API_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
ANALYTICS_API_ALLOWED_SITE_IDS=
ANALYTICS_API_MAX_CONCURRENT_REQUESTS=2
ANALYTICS_API_MAX_RESPONSE_BYTES=1048576

# Pending Session Cleaner
PENDING_SESSION_CLEANER_ENABLED=false
PENDING_SESSION_CLEANER_SSIDS=Zefer_Parki
PENDING_SESSION_CLEANER_INITIAL_DELAY_SECONDS=10
PENDING_SESSION_CLEANER_SCAN_INTERVAL_SECONDS=60
PENDING_SESSION_CLEANER_MAX_SCAN_DURATION_SECONDS=50
PENDING_SESSION_CLEANER_MIN_UPTIME_SECONDS=120
PENDING_SESSION_CLEANER_PORTAL_GRACE_SECONDS=45
PENDING_SESSION_CLEANER_UPTIME_REGRESSION_TOLERANCE_SECONDS=5
PENDING_SESSION_CLEANER_REQUEST_TIMEOUT_SECONDS=5
PENDING_SESSION_CLEANER_GET_RETRY_DELAYS_SECONDS=1,3
PENDING_SESSION_CLEANER_VERIFY_DELAYS_SECONDS=1,4
PENDING_SESSION_CLEANER_PAGE_SIZE=500
PENDING_SESSION_CLEANER_MAX_PAGES=20
PENDING_SESSION_CLEANER_MAX_CLIENTS=10000
PENDING_SESSION_CLEANER_MAX_ACTIONS_PER_SCAN=1
PENDING_SESSION_CLEANER_ACTION_COOLDOWN_SECONDS=180
PENDING_SESSION_CLEANER_MAX_ACTIONS_PER_MAC_PER_HOUR=3
PENDING_SESSION_CLEANER_LOG_FILE=/opt/CaptivePortal/logs/pending_session_cleaner.log
PENDING_SESSION_CLEANER_ROTATION_MAX_BYTES=52428800
PENDING_SESSION_CLEANER_ROTATION_BACKUP_COUNT=20
PENDING_SESSION_CLEANER_SHUTDOWN_TIMEOUT_SECONDS=20
