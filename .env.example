# Authorized Client Snapshot Collector.
# CaptivePortal does not load this file automatically; production values
# are supplied by the process environment or systemd.
VISITOR_SNAPSHOT_ENABLED=false
VISITOR_SNAPSHOT_LOG_FILE=/opt/CaptivePortal/logs/visitor_snapshots.log
VISITOR_SNAPSHOT_MAX_WORKERS=2
VISITOR_SNAPSHOT_MAX_PENDING=100
VISITOR_SNAPSHOT_MAX_JOB_AGE_SECONDS=30
VISITOR_SNAPSHOT_REQUEST_TIMEOUT_SECONDS=5
VISITOR_SNAPSHOT_RETRY_DELAYS_SECONDS=2,5
VISITOR_SNAPSHOT_ROTATION_MAX_BYTES=52428800
VISITOR_SNAPSHOT_ROTATION_BACKUP_COUNT=20
VISITOR_SNAPSHOT_SHUTDOWN_TIMEOUT_SECONDS=90

# Visitor Device Registry
# Keep disabled until the Registry receives separate production approval.
VISITOR_REGISTRY_ENABLED=false
VISITOR_REGISTRY_DB_PATH=/opt/CaptivePortal/data/visitor_registry.sqlite3
VISITOR_REGISTRY_SCAN_INTERVAL_SECONDS=5
VISITOR_REGISTRY_SHUTDOWN_TIMEOUT_SECONDS=10
VISITOR_REGISTRY_MAX_LINE_BYTES=4194304
