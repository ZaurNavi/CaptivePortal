ANALYTICS_VISIT_MIN_COHORT_SIZE=20
ANALYTICS_VISIT_MAX_WINDOW_DAYS=90
ANALYTICS_API_ENABLED=false
# Generate and inject the production token outside Git during activation.
ANALYTICS_API_BEARER_TOKEN=
ANALYTICS_API_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
ANALYTICS_API_ALLOWED_SITE_IDS=
ANALYTICS_API_MAX_CONCURRENT_REQUESTS=2
ANALYTICS_API_MAX_RESPONSE_BYTES=1048576

# Read-only Site-aware Admin Web. Keep disabled until the separate
# owner-controlled production activation task. Generate the password hash
