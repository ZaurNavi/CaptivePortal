+        except Exception as exc:
+            if conn.in_transaction:
+                conn.rollback()
+            if isinstance(exc, ClassificationPersistenceError):
+                raise
+            raise ClassificationPersistenceError("persistence_unavailable") from exc
+        finally:
+            conn.close()
