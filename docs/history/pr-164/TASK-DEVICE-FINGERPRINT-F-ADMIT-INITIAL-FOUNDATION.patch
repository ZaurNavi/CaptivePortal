+    gates = {name: gate(name, (ttl,) if name == "F-C3" else
+                        (ff5,) if name == "F-F5" else
+                        (ff6,) if name == "F-F6" else ())
+             for name in MANDATORY_PRE_ADMISSION_GATES}
+    named = {name: make_artifact_content(kind, {"synthetic": name})
+             for name, kind in _NAMED_TYPES.items() if name != "knowledge_bundle"}
+    named["knowledge_bundle"] = bundle
+    emitter = make_artifact_content("SourceHealthEmitterContract", {"synthetic": "emitter"})
+    contents = list(gates.values()) + list(named.values()) + [ttl, ff5, ff6, emitter]
+    contents.extend(getattr(knowledge, field) for field in knowledge.__dataclass_fields__)
+    return InitialFoundationInputs(
+        prerequisite_gates=gates, named_artifacts=named,
+        source_health_emitter_contracts=(emitter,), knowledge_candidate=knowledge,
+        immutable_dependencies=tuple(contents), ttl_capture_placement_proof=ttl,
