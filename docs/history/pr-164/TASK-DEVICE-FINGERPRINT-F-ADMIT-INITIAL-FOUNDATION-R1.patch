+@pytest.mark.parametrize("stage,committed", [
+    ("BEFORE_BEGIN", False), ("AFTER_BEGIN_BEFORE_WRITES", False),
+    ("AFTER_VALIDITY_BEFORE_GATE", False), ("BEFORE_POINTER_WRITE", False),
