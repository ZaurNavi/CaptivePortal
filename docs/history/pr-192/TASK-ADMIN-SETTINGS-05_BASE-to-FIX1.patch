diff --git a/app/admin_web/templates/admin/settings_portal.html b/app/admin_web/templates/admin/settings_portal.html
new file mode 100644
index 0000000000000000000000000000000000000000..48e98ddb730f9d43fed2d1585cce24c66cf0d7ad
--- /dev/null
+++ b/app/admin_web/templates/admin/settings_portal.html
@@ -0,0 +1,14 @@
+{% extends "admin/base.html" %}
+{% block subtitle %}<p>Global guest-facing presentation settings</p>{% endblock %}
+{% block page_body %}
+<div id="portal-settings-state" class="state-panel" role="status" aria-live="polite">
+  {% if portal_settings_state == 'active' %}Loading Portal settings…{% else %}Settings store unavailable. No changes can be saved.{% endif %}
+</div>
+<form id="portal-settings-form">
+  <div id="portal-settings-groups" class="content-grid"></div>
+  <div class="settings-actions">
+    <button id="portal-settings-save" class="button" type="submit" disabled>Save changes</button>
+    <button id="portal-settings-refresh" class="button button-secondary" type="button">Read current settings</button>
+  </div>
+</form>
+{% endblock %}
