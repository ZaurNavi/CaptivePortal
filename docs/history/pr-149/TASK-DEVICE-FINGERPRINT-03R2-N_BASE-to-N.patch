new file mode 100644
index 0000000000000000000000000000000000000000..8085b42e1762fe8352995f3115d94a65b665c5f8
--- /dev/null
+++ b/app/device_fingerprint_portal/client_hints_projector.py
@@ -0,0 +1,68 @@
+"""Pure pre-live Client Hints observation to portal_headers/2 projection."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from app.device_fingerprint.portal_schemas import validate_portal_headers_v2
+
+from .client_hints_probe import PortalClientHintsProbeObservation
+
+
+def project_portal_headers_v2_candidate(
+    observation: PortalClientHintsProbeObservation,
+) -> dict[str, Any] | None:
+    """Project one sanitized observation without I/O or runtime mutation."""
+    if not isinstance(observation, PortalClientHintsProbeObservation):
+        raise ValueError("Sanitized Client Hints observation required")
+
+    groups = (
+        (observation.model_normalization_state,
+         observation.normalized_model_family_candidate,
+         observation.model_header_present),
+        (observation.platform_version_normalization_state,
+         observation.normalized_platform_version_major_candidate,
+         observation.platform_version_header_present),
+        (observation.form_factors_normalization_state,
+         observation.normalized_form_factors_candidate,
+         observation.form_factors_header_present),
+    )
+    for state, candidate, present in groups:
+        if state not in {"ABSENT", "UNUSABLE", "NORMALIZED"}:
+            raise ValueError("Invalid sanitized normalization state")
+        if ((state == "ABSENT") != (present is False)
+                or (state == "NORMALIZED") != (candidate is not None)):
+            raise ValueError("Inconsistent sanitized observation")
+
+    payload: dict[str, Any] = {
+        "model_family": None,
+        "os_major": None,
+        "form_factor_mobile": None,
+        "form_factor_tablet": None,
+        "form_factor_desktop": None,
+        "model_source": None,
+        "os_major_source": None,
+        "form_factors_source": None,
+    }
+    if observation.model_normalization_state == "NORMALIZED":
+        payload["model_family"] = observation.normalized_model_family_candidate
+        payload["model_source"] = "sec_ch_ua_model"
+    if observation.platform_version_normalization_state == "NORMALIZED":
+        payload["os_major"] = observation.normalized_platform_version_major_candidate
+        payload["os_major_source"] = "sec_ch_ua_platform_version"
+    if observation.form_factors_normalization_state == "NORMALIZED":
+        factors = observation.normalized_form_factors_candidate
+        if (not isinstance(factors, tuple) or not factors
+                or factors != tuple(sorted(set(factors)))
+                or not set(factors) <= {"mobile", "tablet", "desktop"}):
+            raise ValueError("Invalid sanitized form-factor candidate")
+        payload["form_factor_mobile"] = "mobile" in factors
+        payload["form_factor_tablet"] = "tablet" in factors
+        payload["form_factor_desktop"] = "desktop" in factors
+        payload["form_factors_source"] = "sec_ch_ua_form_factors"
+
+    if all(payload[key] is None for key in (
+        "model_source", "os_major_source", "form_factors_source",
+    )):
+        return None
+    return dict(validate_portal_headers_v2(payload))
