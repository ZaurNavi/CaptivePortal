+@pytest.mark.parametrize("case,pairs,message,markers", [
+    ("partial", [(10, 1), (5, 1), (3, 1), (None, None)], "Observed partial AP measurements", 2),
+    ("direction", [(4, None), (None, 2)], "Observed partial AP measurements", 2),
