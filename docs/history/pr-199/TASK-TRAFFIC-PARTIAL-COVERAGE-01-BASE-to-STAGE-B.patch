diff --git a/app/admin_web/historical_traffic_serialization.py b/app/admin_web/historical_traffic_serialization.py
index cf1efcf9376678bef4f12592dc83c966689946fa..38ce07482aebb628dcad4ad996c63714e7f69883 100644
--- a/app/admin_web/historical_traffic_serialization.py
