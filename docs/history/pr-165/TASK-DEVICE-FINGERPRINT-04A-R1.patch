+        "ingest_sequence": number, "producer_id": producer, "source_kind": "dhcp",
+        "source_subtype": None, "capture_source_id": capture, "extractor_name": "dhcp-v1",
+        "extractor_version": "1.0.0", "feature_schema_version": version,
