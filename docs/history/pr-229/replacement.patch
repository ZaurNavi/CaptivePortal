+def test_A15_checkpointed_wal_read_must_not_create_new_sidecars(retained):
+    """Strict TASK no-DB/WAL-creation requirement; existing RO helper conflicts."""
+    path, db, _ = retained
+    assert db.execute("PRAGMA journal_mode=WAL").fetchone()[0] == "wal"
+    db.close()  # Normal shutdown checkpoints and removes both sidecars.
+    before_files = {item.name for item in path.parent.iterdir()}
+    before_bytes = path.read_bytes()
+    assert before_files == {path.name}
+    assert read(path)["state"] == "no_evidence"
+    assert path.read_bytes() == before_bytes
+    assert {item.name for item in path.parent.iterdir()} == before_files
