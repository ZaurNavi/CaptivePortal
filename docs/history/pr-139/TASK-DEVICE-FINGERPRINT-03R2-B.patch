+from app.device_fingerprint.models import DeviceFingerprintUnsupportedSchema, DeviceFingerprintValidationError
+from app.device_fingerprint.portal_schemas import (
+    PORTAL_HEADER_KEYS,
+    PORTAL_HEADER_V2_KEYS,
