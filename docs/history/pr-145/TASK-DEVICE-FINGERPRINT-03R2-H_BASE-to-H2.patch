+    monkeypatch.setattr("app.device_fingerprint_portal.runtime.threading.Thread", ManualThread)
+    value.start()
+    return value, producer, clock
+
+
+def test_idle_worker_has_four_visitor_independent_heartbeat_opportunities(monkeypatch):
