+    assert repo.checkpoint(gen)['last_binding_change_seq']==3
+    job=repo.connection.execute('SELECT * FROM service_binding_replay_jobs').fetchone()
+    assert job['device_id']==DEVICE and job['client_mac']==MAC
+
