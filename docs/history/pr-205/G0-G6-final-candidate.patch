+            reviewed,due=bundle.manifest.index[rule['rule_id']]
+            if not reviewed<=ni_timestamp(at,canonical=True)<due:raise MaterializationConflict()
+            digest(ref.edge_id);canonical_uuid(ref.source_observation_ref,5)
