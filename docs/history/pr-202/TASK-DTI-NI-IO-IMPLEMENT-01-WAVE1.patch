diff --git a/app/network_metadata/success_telemetry.py b/app/network_metadata/success_telemetry.py
new file mode 100644
index 0000000000000000000000000000000000000000..262230e46fd13e980d2b193c313675b396a0bde2
--- /dev/null
+++ b/app/network_metadata/success_telemetry.py
@@ -0,0 +1,34 @@
+"""Bounded process-local minute counters, not durable audit/replay authority."""
+import time
+
+SUMMARY_FIELDS = frozenset({
+    "batch_count", "record_count", "duplicate_count", "fault_aggregate_update_count",
+    "idle_poll_count", "commit_count", "checkpoint_attempt_count",
+    "checkpoint_busy_count", "suppressed_event_count",
+})
+MAX_COUNTER = 9223372036854775807
+
+
+class SuccessCounters:
+    def __init__(self, publish, *, monotonic=time.monotonic):
+        self.publish, self.monotonic = publish, monotonic
+        self.window_started = monotonic()
+        self.counts = {}
+
+    def observe(self, **counts):
+        if not set(counts) <= SUMMARY_FIELDS:
+            raise ValueError("invalid_success_counter")
+        if any(type(value) is not int or not 0 <= value <= MAX_COUNTER for value in counts.values()):
+            raise ValueError("invalid_success_counter")
+        for field, value in counts.items():
+            self.counts[field] = min(MAX_COUNTER, self.counts.get(field, 0) + value)
+
+    def flush_due(self):
+        now = self.monotonic()
+        if now - self.window_started < 60:
+            return
+        if self.counts:
+            # Closed integer fields only; raw source or identity values cannot enter.
+            self.publish(dict(event="success_summary", interval_seconds=60, **self.counts))
+            self.counts.clear()
+        self.window_started = now
diff --git a/app/network_metadata_projection/effective_runtime_state.py b/app/network_metadata_projection/effective_runtime_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..a8c3b0146125083c27b2be8aae887888feb5859f
--- /dev/null
+++ b/app/network_metadata_projection/effective_runtime_state.py
@@ -0,0 +1,26 @@
+"""B1 read-only freshness policy; no DTO expansion or writer side effects."""
+from datetime import datetime, timezone
+
+from app.network_metadata.validation import ni_timestamp
+from app.network_metadata.models import NetworkMetadataValidationError
+
+SOURCE_USABLE_STATES = frozenset({"usable", "registry_degraded", "attribution_unavailable"})
+SOURCE_POLL_STALE_AFTER_SECONDS = 30
+
+
+def effective_runtime_state(row, *, enabled, evaluated_at_utc=None):
+    state, reason = row["runtime_state"], row["safe_reason"]
+    if not enabled or state not in SOURCE_USABLE_STATES:
+        return state, reason
+    try:
+        now = evaluated_at_utc if evaluated_at_utc is not None else datetime.now(timezone.utc)
+        if now.tzinfo is None or now.utcoffset() is None:
+            raise ValueError
+        last = ni_timestamp(row["last_source_poll_at"], canonical=True)
+        age = (now - last).total_seconds()
+        if 0 <= age <= SOURCE_POLL_STALE_AFTER_SECONDS:
+            return state, reason
+    except (ValueError, TypeError, AttributeError, KeyError, IndexError, OverflowError, NetworkMetadataValidationError):
+        pass
+    # Future, missing and malformed timestamps are not evidence of freshness.
+    return "source_unavailable", "source_poll_stale"
