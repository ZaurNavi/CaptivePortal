+"""Bounded paced synthetic replay. Not a production or official Lab gate."""
+
+import ctypes
+import io
+import os
+import time
+from dataclasses import asdict
+
+from .fixtures import EPOCH, SUBJECT, Transmission, write_pcap
+from .meter import slices
+from .model import SECOND, Limits, Counters, Coverage, QualityInterval, instant
+from .pcap import read_pcap
+from .replay import BoundedSink
+
+
+if os.name == "nt":
+    from ctypes import wintypes
+
+    class _ProcessMemory(ctypes.Structure):
+        _fields_ = [("cb", wintypes.DWORD), ("faults", wintypes.DWORD)] + [
+            (name, ctypes.c_size_t) for name in ("peak", "rss", "paged_peak", "paged", "nonpaged_peak", "nonpaged", "pagefile", "pagefile_peak")]
+
+    # Define once: ctypes POINTER caches types, so per-sample class creation leaks.
+    _kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    _kernel.GetCurrentProcess.restype = wintypes.HANDLE
+    _psapi = ctypes.WinDLL("psapi", use_last_error=True)
+    _psapi.GetProcessMemoryInfo.argtypes = [wintypes.HANDLE, ctypes.POINTER(_ProcessMemory), wintypes.DWORD]
+
+
+def rss_bytes():
+    if os.name == "nt":
+        memory = _ProcessMemory()
+        memory.cb = ctypes.sizeof(memory)
+        if not _psapi.GetProcessMemoryInfo(_kernel.GetCurrentProcess(), ctypes.byref(memory), memory.cb):
+            raise OSError(ctypes.get_last_error(), "process_memory_query_failed")
+        return memory.rss
+    # Linux current RSS, not historical resource.ru_maxrss units.
+    with open("/proc/self/statm", "r", encoding="ascii") as stream:
+        return int(stream.read(256).split()[1]) * os.sysconf("SC_PAGE_SIZE")
+
+
+class DiscardSink:
+    def write(self, data):
+        return len(data)
+
+    def flush(self):
+        pass
+
+
+def paced_replay(pps, duration_seconds=10):
+    if type(pps) is not int or not 1 <= pps <= 38000 or type(duration_seconds) is not int or not 1 <= duration_seconds <= 30:
+        raise ValueError("bounded paced fixture: 1..38000 pps, 1..30 seconds")
+    count = pps * duration_seconds
+    coverage = Coverage("paced-synthetic", "offline-load-only", SUBJECT, EPOCH, EPOCH + duration_seconds * SECOND,
+                        (QualityInterval(EPOCH, EPOCH + duration_seconds * SECOND, "healthy"),))
+    limits, counters = Limits(), Counters()
+    rss_start = rss_bytes()
+    peak = rss_start
+    wall_start, cpu_start = time.perf_counter(), time.process_time()
+    maximum_drift = 0.0
+    emission_drifts = []
+    # Native average 1030 bytes approximates 156.6 Mbit/s at 19000 pps.
+    # Each chunk is bounded to 190 records (~10 KiB header-only PCAP).
+    chunk_records = min(190, pps)
+    def packets():
+        nonlocal peak, maximum_drift
+        for first in range(0, count, chunk_records):
+            size = min(chunk_records, count - first)
+            target = wall_start + first / pps
+            remaining = target - time.perf_counter()
+            if remaining > 0:
+                time.sleep(remaining)
+            maximum_drift = max(maximum_drift, time.perf_counter() - target)
+            block = io.BytesIO()
+            write_pcap(block, (Transmission(i * SECOND // pps, length=1030, transmission_id=i) for i in range(first, first + size)))
+            block.seek(0)
+            for packet in read_pcap(block, limits, counters):
+                yield packet
+            peak = max(peak, rss_bytes())
+    sink = BoundedSink(DiscardSink(), limits.max_output_bytes)
+    for row in slices(packets(), coverage, limits=limits, counters=counters):
+        sink.write(row)
+        emission_drifts.append(max(0.0, time.perf_counter() - wall_start - (instant(row["slice_end_utc"]) - EPOCH) / SECOND))
+    # Consume the final pacing interval before claiming the offered rate.
+    remaining = wall_start + duration_seconds - time.perf_counter()
+    if remaining > 0:
+        time.sleep(remaining)
+    elapsed, cpu = time.perf_counter() - wall_start, time.process_time() - cpu_start
+    return dict(execution_mode="OFFLINE_LAB", offered_pps=pps, native_mbit_per_second=pps * 1030 * 8 / 1_000_000,
+                duration_seconds=duration_seconds, elapsed_seconds=elapsed, cpu_seconds=cpu,
+                single_core_cpu_percent=100 * cpu / elapsed, rss_start_bytes=rss_start,
+                rss_peak_sampled_bytes=peak, incremental_rss_bytes=max(0, peak - rss_start),
+                generation_included_in_cpu=True, buffer_chunk_records=chunk_records, queue_peak_records=1,
+                maximum_pacing_drift_seconds=maximum_drift, output_bytes=sink.bytes_written,
+                slice_emission_drift_seconds=emission_drifts,
+                slice_emissions_per_second=counters.slices_emitted / elapsed,
+                output_bytes_per_second=sink.bytes_written / elapsed, counters=asdict(counters),
+                accounted_exactly=counters.accounted_packets == count and counters.accounted_bytes_native == count * 1030,
+                sustained_for_fixture=maximum_drift < 0.25 and counters.accounted_packets == count,
+                capture_drops="NOT_APPLICABLE_OFFLINE", production_admission=False)
