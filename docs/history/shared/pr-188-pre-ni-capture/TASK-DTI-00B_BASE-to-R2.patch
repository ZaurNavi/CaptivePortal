index 0000000000000000000000000000000000000000..643aa009a2c0c270ca8f72d8842f848833c51526
--- /dev/null
+++ b/research/dti_00b/live_capture.py
@@ -0,0 +1,205 @@
+"""Linux independent raw packet socket; no transmit, fanout, ring or NIC changes."""
+
+import re
+import select
+import socket
+import struct
+import sys
+import time
+from dataclasses import dataclass
+from pathlib import Path
+
+from .model import SECOND, Limits
+from .pcap import parse_header
+
+# Linux UAPI values, also usable by injected socket doubles on non-Linux hosts.
+AF_PACKET = 17
+SOL_PACKET = 263
+PACKET_STATISTICS = 6
+SO_TIMESTAMPNS_NEW = 64
+SO_TIMESTAMPNS_OLD = 35
+ETH_P_ALL = 3
+HEADER_BYTES = 82
+ANCILLARY_BYTES = 128
+POLL_NS = SECOND // 4
+
+
+class Clock:
+    utc_ns = staticmethod(time.time_ns)
+    monotonic_ns = staticmethod(time.monotonic_ns)
+    sleep = staticmethod(time.sleep)
+
+
+@dataclass(frozen=True)
+class LiveConfig:
+    interface: str
+    subject_mac: str
+    capture_source_id: str
+    test_scope: str
+    duration_seconds: int
+    receive_buffer_bytes: int = 1024 * 1024
+    limits: Limits = Limits()
+
+    def __post_init__(self):
+        if not isinstance(self.limits, Limits):
+            raise ValueError("accepted bounded Limits required")
+        if (not isinstance(self.interface, str) or self.interface in (".", "..")
+                or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", self.interface)):
+            raise ValueError("explicit Linux interface required")
+        if type(self.duration_seconds) is not int or not 1 <= self.duration_seconds <= 300:
+            raise ValueError("explicit finite duration: 1..300 integer seconds")
+        if type(self.receive_buffer_bytes) is not int or not 4096 <= self.receive_buffer_bytes <= 4 * 1024 * 1024:
+            raise ValueError("receive buffer bound: 4KiB..4MiB")
+        # Reuse the accepted source/scope/subject validation, without a new schema.
+        from .model import Coverage, QualityInterval
+        Coverage(self.capture_source_id, self.test_scope, self.subject_mac, 0, SECOND,
+                 (QualityInterval(0, SECOND, "healthy"),))
+
+
+def link_ready(interface, *, sysfs_root=Path("/sys/class/net")):
+    root = sysfs_root / interface
+    try:
+        with (root / "flags").open("r", encoding="ascii") as stream:
+            flags = int(stream.read(64).strip(), 16)
+        with (root / "type").open("r", encoding="ascii") as stream:
+            hardware_type = int(stream.read(64).strip())
+        with (root / "carrier").open("r", encoding="ascii") as stream:
+            carrier = int(stream.read(64).strip())
+    except (ValueError, OSError) as exc:
+        raise OSError("capture_link_probe_failed") from exc
+    # sysfs dev->flags need not contain the synthesized ioctl IFF_RUNNING bit.
+    return hardware_type == 1 and bool(flags & 1) and carrier == 1
+
+
+def queue_readable(sock):
+    return bool(select.select([sock], [], [], 0)[0])
+
+
+class LinuxPacketSource:
+    def __init__(self, config, clock, *, socket_factory=socket.socket,
+                 platform=None, link_probe=link_ready, queue_probe=queue_readable):
+        self.config, self.clock = config, clock
+        self.factory = socket_factory
+        self.platform = sys.platform if platform is None else platform
+        self.link_probe, self.queue_probe = link_probe, queue_probe
+        self.sock = None
+        self.buffer = bytearray(HEADER_BYTES)
+        self.timestamp_option = None
+        self.ordinal = 0
+        self.evidence = dict(socket_open=False, socket_bound=False, socket_closed=False,
+                             packets_received=0, kernel_packets=0, kernel_drops=0,
+                             statistics_polls=0, kernel_statistics_available=None,
+                             receive_buffer_requested_bytes=config.receive_buffer_bytes,
+                             receive_buffer_effective_bytes=None, timestamp_mode="UNAVAILABLE",
+                             queue_readable_at_seal=0, link_checks=0)
+
+    def open(self):
+        if not self.platform.startswith("linux"):
+            raise OSError("live capture is Linux-only")
+        try:
+            if not self.link_probe(self.config.interface):
+                raise OSError("Ethernet interface not UP/carrier-ready")
+            # Protocol zero prevents reception on arbitrary interfaces before bind.
+            self.sock = self.factory(AF_PACKET, socket.SOCK_RAW, 0)
+            self.evidence["socket_open"] = True
+            self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, self.config.receive_buffer_bytes)
+            effective = self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF)
+            if not 0 < effective <= 8 * 1024 * 1024:
+                raise OSError("kernel receive buffer exceeds prototype bound")
+            self.evidence["receive_buffer_effective_bytes"] = effective
+            for option in (SO_TIMESTAMPNS_NEW, SO_TIMESTAMPNS_OLD):
+                try:
+                    self.sock.setsockopt(socket.SOL_SOCKET, option, 1)
+                    self.timestamp_option = option
+                    self.evidence["timestamp_mode"] = "KERNEL_UTC_NS_NEW" if option == SO_TIMESTAMPNS_NEW else "KERNEL_UTC_NS_OLD"
+                    break
+                except OSError:
+                    continue
+            # Python's AF_PACKET bind protocol argument is host-order ETH_P_ALL.
+            self.sock.bind((self.config.interface, ETH_P_ALL))
+            self.evidence["socket_bound"] = True
+        except BaseException:
+            self.close()
+            raise
+
+    def receive(self, timeout_seconds):
+        self.sock.settimeout(timeout_seconds)
+        try:
+            size, ancillary, flags, address = self.sock.recvmsg_into(
+                [self.buffer], ANCILLARY_BYTES, getattr(socket, "MSG_TRUNC", 0x20))
+            self.evidence["packets_received"] += 1
+            ordinal = self.ordinal
+            self.ordinal += 1
+            timestamp, reasons = self.clock.utc_ns(), set()
+            found = []
+            for level, kind, data in ancillary:
+                if level == socket.SOL_SOCKET and kind == self.timestamp_option:
+                    layout = "=qq" if kind == SO_TIMESTAMPNS_NEW else "@ll"
+                    if len(data) == struct.calcsize(layout):
+                        seconds, nanos = struct.unpack(layout, data)
+                        if seconds >= 0 and 0 <= nanos < SECOND:
+                            found.append(seconds * SECOND + nanos)
+            if len(found) == 1:
+                timestamp = found[0]
+            else:
+                reasons.add("kernel_timestamp_missing_or_invalid")
+            if flags & getattr(socket, "MSG_CTRUNC", 8):
+                reasons.add("timestamp_control_truncated")
+            if len(address) < 4 or address[0] != self.config.interface or address[3] != 1:
+                reasons.add("unexpected_capture_interface_or_link_type")
+                header = b""
+            elif size > self.config.limits.max_record_bytes:
+                reasons.add("frame_wire_length_limit")
+                header = b""
+            else:
+                header = bytes(self.buffer[:min(size, HEADER_BYTES)])
+            # MSG_TRUNC is intentional header-only capture, not loss of IP bytes:
+            # the kernel returns original wire length and parser retains headers only.
+            packet = parse_header(ordinal, timestamp, header, size)
+            return packet, reasons
+        finally:
+            # Do not leave transport/application prefix bytes in the receive buffer.
+            self.buffer[:] = b"\0" * HEADER_BYTES
+
+    def health(self, *, sealing=False):
+        reasons = set()
+        self.evidence["link_checks"] += 1
+        if not self.link_probe(self.config.interface):
+            raise OSError("capture link no longer UP/carrier-ready")
+        if self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR):
+            raise OSError("packet socket error")
+        self.evidence["statistics_polls"] += 1
+        try:
+            raw = self.sock.getsockopt(SOL_PACKET, PACKET_STATISTICS, 8)
+            if len(raw) != 8:
+                raise OSError("invalid packet statistics")
+            packets, drops = struct.unpack("=II", raw)
+            # PACKET_STATISTICS resets on read; retain cumulative run evidence.
+            self.evidence["kernel_packets"] += packets
+            self.evidence["kernel_drops"] += drops
+            self.evidence["kernel_statistics_available"] = True
+            if drops:
+                reasons.add("kernel_receive_drops")
+        except OSError:
+            self.evidence["kernel_statistics_available"] = False
+            reasons.add("kernel_drop_evidence_unavailable")
+        if self.timestamp_option is None:
+            reasons.add("kernel_timestamp_unavailable")
+        if sealing:
+            try:
+                if self.queue_probe(self.sock):
+                    self.evidence["queue_readable_at_seal"] += 1
+                    reasons.add("kernel_queue_not_drained_at_seal")
+            except OSError:
+                reasons.add("kernel_queue_evidence_unavailable")
+        # Queue readability is observable, but byte/packet queue depth is not claimed.
+        return reasons
+
+    def close(self):
+        if self.sock is not None:
+            try:
+                self.sock.close()
+            finally:
+                self.sock = None
+                self.evidence["socket_closed"] = True
+                self.buffer[:] = b"\0" * HEADER_BYTES
