@@ -0,0 +1,104 @@
+"""One subject, one current slice, one lookahead and a bounded provenance cache."""
+
+import uuid
+from collections import OrderedDict
+
+from .model import CADENCE, QUALITIES, Limits, Counters, make_slice, utc
+
+
+def slices(packets, coverage, *, limits=None, counters=None, run_id=None, stop_at=None, split_visit=False):
+    limits = limits or Limits()
+    counters = counters or Counters()
+    run_id = run_id or str(uuid.uuid4())
+    if str(uuid.UUID(run_id)) != run_id:
+        raise ValueError("canonical run UUID required")
+    if stop_at is not None and not coverage.start < stop_at <= coverage.end:
+        raise ValueError("restart stop must be inside coverage")
+    duplicates = dict(coverage.duplicate_records)
+    originals = set(duplicates.values())
+    cache = OrderedDict()
+    iterator = iter(packets)
+    pending = next(iterator, None)
+    start = coverage.start // CADENCE * CADENCE
+    final = ((coverage.end + CADENCE - 1) // CADENCE) * CADENCE
+    sequence, previous = 0, -1
+    while start < final:
+        end = min(start + CADENCE - start % CADENCE, final)
+        if split_visit and coverage.visit_boundary is not None and start < coverage.visit_boundary < end:
+            end = coverage.visit_boundary
+        state = coverage.quality(start, end)
+        reasons = set()
+        if stop_at is not None:
+            if start >= stop_at:
+                state = "prototype_unavailable"
+                reasons.add("restart_gap")
+            elif stop_at < end:
+                state = max((state, "partial"), key=QUALITIES.index)
+                reasons.add("open_interval_at_restart")
+        counts = dict(upload_packets=0, download_packets=0, upload_bytes_native=0, download_bytes_native=0,
+                      first_packet_at=None, last_packet_at=None)
+        while pending is not None and pending.timestamp < end:
+            packet = pending
+            if packet.timestamp < previous:
+                raise ValueError("event_time_order_required")
+            previous = packet.timestamp
+            counters.raw_packets_seen += 1
+            if not coverage.start <= packet.timestamp < coverage.end or (stop_at is not None and packet.timestamp >= stop_at):
+                counters.outside_coverage_packets += 1
+            elif packet.error:
+                counters.rejected_packets += 1
+                state = max((state, "degraded"), key=QUALITIES.index)
+                reasons.add("rejected_header")
+            elif packet.src_mac == coverage.subject_mac and packet.dst_mac != coverage.subject_mac:
+                state = account(packet, "upload", counts, state, reasons, coverage, limits, counters, cache, duplicates, originals)
+            elif packet.dst_mac == coverage.subject_mac and packet.src_mac != coverage.subject_mac:
+                state = account(packet, "download", counts, state, reasons, coverage, limits, counters, cache, duplicates, originals)
+            else:
+                counters.out_of_scope_packets += 1
+            pending = next(iterator, None)
+        sequence += 1
+        counters.slices_emitted += 1
+        yield make_slice(coverage, start, end, run_id, sequence, counts, state, reasons)
+        start = end
+    # Consume the tail to validate framing/order; it must never enter accounting.
+    while pending is not None:
+        if pending.timestamp < previous:
+            raise ValueError("event_time_order_required")
+        previous = pending.timestamp
+        counters.raw_packets_seen += 1
+        counters.outside_coverage_packets += 1
+        pending = next(iterator, None)
+
+
+def account(packet, direction, counts, state, reasons, coverage, limits, counters, cache, duplicates, originals):
+    counters.raw_packets_in_scope += 1
+    counters.raw_bytes_native += packet.native_length
+    while cache and packet.timestamp - next(iter(cache.values())).timestamp > limits.dedup_horizon_ns:
+        cache.popitem(last=False)
+        counters.dedup_evictions += 1
+    if packet.ordinal in duplicates:
+        counters.duplicate_candidates += 1
+        original = cache.get(duplicates[packet.ordinal])
+        if original is not None and (original.header_identity, original.native_length) == (packet.header_identity, packet.native_length):
+            counters.deduplicated_packets += 1
+            counters.dedup_cache_entries = len(cache)
+            return state
+        # Never drop a packet when the trusted fixture claim cannot be corroborated.
+        counters.duplicate_provenance_unresolved += 1
+        reasons.add("duplicate_provenance_unresolved")
+        state = max((state, "degraded"), key=QUALITIES.index)
+    if packet.ordinal in originals:
+        cache[packet.ordinal] = packet
+        if len(cache) > limits.dedup_entries:
+            cache.popitem(last=False)
+            counters.dedup_evictions += 1
+    counters.dedup_cache_entries = len(cache)
+    counters.dedup_peak_entries = max(counters.dedup_peak_entries, len(cache))
+    counters.accounted_packets += 1
+    counters.accounted_bytes_native += packet.native_length
+    counts[direction + "_packets"] += 1
+    counts[direction + "_bytes_native"] += packet.native_length
+    if counts["first_packet_at"] is None:
+        counts["first_packet_at"] = utc(packet.timestamp)
+    counts["last_packet_at"] = utc(packet.timestamp)
+    return state
