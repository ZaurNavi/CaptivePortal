+"""Research CLI. Only explicit 'live' selects Linux capture; never at import."""
+
+import argparse
+import json
+from pathlib import Path
+
+from .benchmark import paced_replay
+from .admission import reconciliation, source_identity
+from .fixtures import scenarios, write_pcap
+from .model import Limits, canonical
+from .replay import replay
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+    fixture = sub.add_parser("fixture")
+    fixture.add_argument("scenario", choices=tuple(scenarios()))
+    fixture.add_argument("directory", type=Path)
+    read = sub.add_parser("replay")
+    read.add_argument("input")
+    read.add_argument("manifest")
+    read.add_argument("output")
+    read.add_argument("--split-visit", action="store_true")
+    read.add_argument("--max-output-bytes", type=int, default=Limits().max_output_bytes)
+    load = sub.add_parser("paced")
+    load.add_argument("--pps", type=int, required=True)
+    load.add_argument("--seconds", type=int, default=10)
+    load.add_argument("--report", type=Path)
+    admission = sub.add_parser("reconcile")
+    admission.add_argument("--report", type=Path, required=True)
+    sub.add_parser("identity")
+    live = sub.add_parser("live", help="Linux research capture; separate host authorization required")
+    live.add_argument("--interface", required=True)
+    live.add_argument("--subject-mac", required=True)
+    live.add_argument("--capture-source-id", required=True)
+    live.add_argument("--test-scope", required=True)
+    live.add_argument("--duration-seconds", type=int, required=True)
+    live.add_argument("--output", type=Path, required=True)
+    live.add_argument("--receive-buffer-bytes", type=int, default=1024 * 1024)
+    live.add_argument("--max-output-bytes", type=int, default=Limits().max_output_bytes)
+    args = parser.parse_args()
+    try:
+        if args.command == "fixture":
+            case = scenarios()[args.scenario]
+            args.directory.mkdir(parents=True, exist_ok=False)
+            with (args.directory / "headers.pcap").open("xb") as stream:
+                write_pcap(stream, case.events)
+            with (args.directory / "coverage.json").open("x", encoding="utf-8", newline="\n") as stream:
+                stream.write(canonical(case.coverage.as_dict()) + "\n")
+            print(canonical(dict(status="SYNTHETIC_FIXTURE_CREATED", scenario=args.scenario, production=False)))
+        elif args.command == "paced":
+            report = paced_replay(args.pps, args.seconds)
+            if args.report:
+                with args.report.open("x", encoding="utf-8", newline="\n") as stream:
+                    stream.write(canonical(report) + "\n")
+            print(canonical(report))
+        elif args.command == "reconcile":
+            report = reconciliation()
+            with args.report.open("x", encoding="utf-8", newline="\n") as stream:
+                stream.write(canonical(report) + "\n")
+            print(canonical(dict(status="RECONCILIATION_REPORTED", all_sixteen_reconciled=report["all_sixteen_reconciled"],
+                                 report=str(args.report), official_acceptance=False)))
+        elif args.command == "identity":
+            print(canonical(source_identity()))
+        elif args.command == "live":
+            from .live import live_to_file
+            from .live_capture import LiveConfig
+            config = LiveConfig(args.interface, args.subject_mac, args.capture_source_id, args.test_scope,
+                                args.duration_seconds, args.receive_buffer_bytes,
+                                Limits(max_output_bytes=args.max_output_bytes))
+            report = live_to_file(config, args.output)
+            print(canonical(report))
+            return 0 if report["status"] in ("COMPLETE", "STOPPED") else 2
+        else:
+            print(canonical(replay(args.input, args.manifest, args.output,
+                                   limits=Limits(max_output_bytes=args.max_output_bytes), split_visit=args.split_visit)))
+        return 0
+    except (ValueError, OSError) as exc:
+        print(json.dumps(dict(status="BLOCKED", capture_quality_state="prototype_unavailable",
+                              reason=str(exc), completed_accounting=False)))
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
