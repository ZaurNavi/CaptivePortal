@@ -0,0 +1,117 @@
+"""Streaming classic-PCAP reader: retain Ethernet/IP headers, discard other bytes."""
+
+import ipaddress
+import struct
+from dataclasses import dataclass
+
+from .model import SECOND
+
+
+class CaptureError(ValueError):
+    """No success report may be published after a structurally broken input."""
+
+
+@dataclass(frozen=True)
+class Packet:
+    ordinal: int
+    timestamp: int
+    src_mac: str = None
+    dst_mac: str = None
+    src_ip: str = None
+    dst_ip: str = None
+    protocol: int = None
+    native_length: int = 0
+    # Only bounded Ethernet/IP header bytes; never TCP/application payload.
+    header_identity: bytes = b""
+    error: str = None
+
+
+def parse_header(ordinal, timestamp, header, original_length):
+    if len(header) < 14:
+        return Packet(ordinal, timestamp, error="truncated_ethernet_header")
+    dst = ":".join(f"{v:02x}" for v in header[:6])
+    src = ":".join(f"{v:02x}" for v in header[6:12])
+    if header[0] & 1 or header[6] & 1:
+        return Packet(ordinal, timestamp)  # Non-unicast scope is intentionally not frozen.
+    offset, ether_type = 14, int.from_bytes(header[12:14], "big")
+    tags = 0
+    while ether_type in (0x8100, 0x88A8):
+        if tags == 2 or len(header) < offset + 4:
+            return Packet(ordinal, timestamp, error="unsupported_or_truncated_vlan")
+        ether_type = int.from_bytes(header[offset + 2:offset + 4], "big")
+        offset += 4
+        tags += 1
+    ip = header[offset:]
+    try:
+        if ether_type == 0x0800:
+            if len(ip) < 20 or ip[0] >> 4 != 4:
+                raise ValueError("truncated_or_invalid_ipv4")
+            width = (ip[0] & 15) * 4
+            length = int.from_bytes(ip[2:4], "big")
+            if width < 20 or len(ip) < width or length < width:
+                raise ValueError("invalid_ipv4_lengths")
+            src_ip, dst_ip = str(ipaddress.IPv4Address(ip[12:16])), str(ipaddress.IPv4Address(ip[16:20]))
+            protocol = ip[9]
+        elif ether_type == 0x86DD:
+            if len(ip) < 40 or ip[0] >> 4 != 6:
+                raise ValueError("truncated_or_invalid_ipv6")
+            width = 40
+            payload = int.from_bytes(ip[4:6], "big")
+            if payload == 0:
+                # Jumbogram interpretation needs an extension-header contract, out of scope.
+                raise ValueError("ipv6_zero_payload_or_jumbogram_unsupported")
+            length = 40 + payload
+            src_ip, dst_ip = str(ipaddress.IPv6Address(ip[8:24])), str(ipaddress.IPv6Address(ip[24:40]))
+            protocol = ip[6]  # IPv6 base-header Next Header; no application parsing.
+        else:
+            return Packet(ordinal, timestamp)
+        if original_length < offset + length:
+            raise ValueError("wire_length_smaller_than_declared_ip")
+        if ipaddress.ip_address(dst_ip).is_multicast:
+            return Packet(ordinal, timestamp)
+        return Packet(ordinal, timestamp, src, dst, src_ip, dst_ip, protocol, length, header[:offset + width])
+    except ValueError as exc:
+        return Packet(ordinal, timestamp, error=str(exc))
+
+
+def read_pcap(stream, limits, counters):
+    global_header = stream.read(24)
+    magic = {b"\xd4\xc3\xb2\xa1": ("<", 1000), b"\xa1\xb2\xc3\xd4": (">", 1000),
+             b"\x4d\x3c\xb2\xa1": ("<", 1), b"\xa1\xb2\x3c\x4d": (">", 1)}
+    if len(global_header) != 24 or global_header[:4] not in magic:
+        raise CaptureError("classic_pcap_required")
+    endian, scale = magic[global_header[:4]]
+    major, minor, _, _, snaplen, link = struct.unpack(endian + "HHIIII", global_header[4:])
+    if (major, minor) != (2, 4) or link != 1 or not 0 < snaplen <= limits.max_record_bytes:
+        raise CaptureError("unsupported_pcap_header")
+    previous = -1
+    ordinal = 0
+    while True:
+        record_header = stream.read(16)
+        if not record_header:
+            return
+        if len(record_header) != 16:
+            raise CaptureError("truncated_record_header")
+        sec, fraction, captured, original = struct.unpack(endian + "IIII", record_header)
+        if fraction >= SECOND // scale or captured > snaplen or captured > original:
+            raise CaptureError("invalid_record_header")
+        if ordinal >= limits.max_records:
+            raise CaptureError("record_limit_exceeded")
+        timestamp = sec * SECOND + fraction * scale
+        if timestamp < previous:
+            raise CaptureError("event_time_order_required")
+        previous = timestamp
+        # At most 22 L2 + 60 IPv4 / 40 IPv6 bytes are retained.
+        keep = min(captured, 82)
+        header = stream.read(keep)
+        if len(header) != keep:
+            raise CaptureError("truncated_record_data")
+        remaining = captured - keep
+        while remaining:
+            discarded = stream.read(min(4096, remaining))
+            if not discarded:
+                raise CaptureError("truncated_record_data")
+            remaining -= len(discarded)
+        counters.input_buffer_peak_bytes = max(counters.input_buffer_peak_bytes, keep + min(4096, max(0, captured - keep)))
+        yield parse_header(ordinal, timestamp, header, original)
+        ordinal += 1
