+import json
+import subprocess
+import sys
+
+import pytest
+
+from research.dti_00b.benchmark import paced_replay, rss_bytes
+from research.dti_00b.admission import reconciliation
+from research.dti_00b.fixtures import scenarios, write_pcap
+from research.dti_00b.model import Limits, canonical
+from research.dti_00b.replay import BoundedSink, OutputUnavailable, load_coverage, replay
+
+
+def files(tmp_path):
+    pcap, manifest, output = [tmp_path / name for name in ("headers.pcap", "coverage.json", "slices.jsonl")]
+    with pcap.open("wb") as stream:
+        write_pcap(stream, scenarios()["B"].events)
+    manifest.write_text(canonical(scenarios()["B"].coverage.as_dict()), encoding="utf-8")
+    return pcap, manifest, output
+
+
+def test_file_replay_exclusive_bounded_output_and_no_payload(tmp_path):
+    pcap, manifest, output = files(tmp_path)
+    result = replay(pcap, manifest, output)
+    assert result["status"] == "COMPLETE"
+    assert result["counters"]["accounted_packets"] == 20
+    assert result["output_bytes"] == output.stat().st_size
+    rows = [json.loads(row) for row in output.read_text().splitlines()]
+    assert len(rows) == 4
+    assert all("src_ip" not in row and "payload" not in row for row in rows)
+    with pytest.raises(FileExistsError):
+        replay(pcap, manifest, output)
+
+
+def test_output_ceiling_blocks_before_overflow(tmp_path):
+    pcap, manifest, output = files(tmp_path)
+    with pytest.raises(OutputUnavailable, match="output_limit"):
+        replay(pcap, manifest, output, limits=Limits(max_output_bytes=100))
+    assert output.stat().st_size == 0
+
+
+@pytest.mark.parametrize("mode", ["disk_full", "short_write"])
+def test_sink_io_failure_never_success_or_retry_without_accounting(mode):
+    class BrokenSink:
+        def write(self, data):
+            if mode == "disk_full":
+                raise OSError("no space left")
+            return 1
+
+        def flush(self):
+            pass
+    sink = BoundedSink(BrokenSink(), 100)
+    with pytest.raises(OutputUnavailable, match="prototype_unavailable"):
+        sink.write({"slice_id": "synthetic"})
+    assert sink.bytes_written == 0
+
+
+def test_duplicate_manifest_keys_and_oversized_manifest_rejected(tmp_path):
+    manifest = tmp_path / "manifest.json"
+    manifest.write_text('{"a":1,"a":2}')
+    with pytest.raises(ValueError, match="duplicate_json_key"):
+        load_coverage(manifest)
+    manifest.write_bytes(b" " * (1024 * 1024 + 1))
+    with pytest.raises(ValueError, match="manifest_byte_limit"):
+        load_coverage(manifest)
+
+
+def test_cli_local_file_only_import_and_replay(tmp_path):
+    pcap, manifest, output = files(tmp_path)
+    completed = subprocess.run([sys.executable, "-m", "research.dti_00b", "replay", str(pcap), str(manifest), str(output)],
+                               capture_output=True, text=True, check=False)
+    assert completed.returncode == 0, completed.stderr
+    assert json.loads(completed.stdout)["production_access"] is False
+
+
+@pytest.mark.parametrize("pps", [19000, 38000])
+def test_bounded_baseline_and_double_load_paced_smoke(pps):
+    result = paced_replay(pps, 1)
+    assert result["accounted_exactly"]
+    assert result["counters"]["rejected_packets"] == 0
+    assert result["queue_peak_records"] == 1
+    assert result["buffer_chunk_records"] <= 190
+    assert result["rss_peak_sampled_bytes"] > 0
+    assert result["cpu_seconds"] >= 0
+    assert result["elapsed_seconds"] >= 1
+    assert not result["production_admission"]
+
+
+def test_pacing_configuration_bounded():
+    with pytest.raises(ValueError):
+        paced_replay(38001)
+    with pytest.raises(ValueError):
+        paced_replay(19000, 31)
+
+
+def test_reconciliation_report_keeps_independent_truth_and_no_formal_acceptance():
+    report = reconciliation()
+    assert report["all_sixteen_reconciled"]
+    assert len(report["scenarios"]) == 16
+    assert not report["official_acceptance"]
+    assert report["arbitrary_mirror_duplicate_admission"].startswith("PARTIAL")
+    assert len(report["source_identity"]["package_sha256"]) == 64
+
+
+def test_memory_observer_does_not_create_a_new_cached_ctypes_type_per_sample():
+    import ctypes
+    before = set(ctypes._pointer_type_cache)
+    for _ in range(100):
+        assert rss_bytes() > 0
+    assert set(ctypes._pointer_type_cache) == before
