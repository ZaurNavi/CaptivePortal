index 0000000000000000000000000000000000000000..a57e4bc38c3b57c77d82652394e6869693fa3d49
--- /dev/null
+++ b/research/dti_00b/fixtures.py
@@ -0,0 +1,109 @@
+"""Independent logical sender timelines -> header-only PCAP + expected totals.
+
+Truth is computed from declared transmissions, not from parsed PCAP/meter output.
+All addresses are synthetic; these are not actual controlled-client captures.
+"""
+
+import ipaddress
+import struct
+from dataclasses import dataclass
+
+from .model import SECOND, CADENCE, Coverage, QualityInterval
+
+SUBJECT = "02:00:00:00:00:01"
+PEER = "02:00:00:00:00:02"
+EPOCH = 1_800_000_000 * SECOND  # ordinary synthetic data, not an admission anchor
+
+
+@dataclass(frozen=True)
+class Transmission:
+    offset_ns: int
+    direction: str = "upload"
+    ip_version: int = 4
+    length: int = 100
+    transmission_id: int = 1
+    duplicate_of: int = None
+
+
+@dataclass(frozen=True)
+class Fixture:
+    name: str
+    events: tuple
+    coverage: Coverage
+    stop_at: int = None
+
+    def reference(self, split_visit=False):
+        """Independent arithmetic oracle over logical transmissions and declared T."""
+        boundaries = list(range(self.coverage.start // CADENCE * CADENCE,
+                                ((self.coverage.end + CADENCE - 1) // CADENCE) * CADENCE + 1, CADENCE))
+        if split_visit and self.coverage.visit_boundary is not None:
+            boundaries = sorted(set(boundaries + [self.coverage.visit_boundary]))
+        rows = []
+        for start, end in zip(boundaries, boundaries[1:]):
+            events = [e for e in self.events if e.duplicate_of is None
+                      and max(start, self.coverage.start) <= EPOCH + e.offset_ns < min(end, self.coverage.end)
+                      and (self.stop_at is None or EPOCH + e.offset_ns < self.stop_at)]
+            rows.append(dict(start=start, end=end,
+                             upload_packets=sum(e.direction == "upload" for e in events),
+                             download_packets=sum(e.direction == "download" for e in events),
+                             upload_bytes_native=sum(e.length for e in events if e.direction == "upload"),
+                             download_bytes_native=sum(e.length for e in events if e.direction == "download")))
+        return rows
+
+
+def header(event, vlan=False):
+    src, dst = (SUBJECT, PEER) if event.direction == "upload" else (PEER, SUBJECT)
+    layer2 = bytes.fromhex(dst.replace(":", "")) + bytes.fromhex(src.replace(":", ""))
+    ethertype = 0x0800 if event.ip_version == 4 else 0x86DD
+    layer2 += struct.pack("!HHH", 0x8100, 20, ethertype) if vlan else struct.pack("!H", ethertype)
+    if event.ip_version == 4:
+        src_ip, dst_ip = ("192.0.2.1", "192.0.2.2") if event.direction == "upload" else ("192.0.2.2", "192.0.2.1")
+        layer3 = struct.pack("!BBHHHBBH4s4s", 0x45, 0, event.length, event.transmission_id % 65536,
+                             0, 64, 6, 0, ipaddress.ip_address(src_ip).packed, ipaddress.ip_address(dst_ip).packed)
+    else:
+        src_ip, dst_ip = ("2001:db8::1", "2001:db8::2") if event.direction == "upload" else ("2001:db8::2", "2001:db8::1")
+        layer3 = struct.pack("!IHBB16s16s", 6 << 28, event.length - 40, 6, 64,
+                             ipaddress.ip_address(src_ip).packed, ipaddress.ip_address(dst_ip).packed)
+    return layer2 + layer3  # No transport/application payload is produced or retained.
+
+
+def write_pcap(stream, events, *, endian="<", nanos=True, vlan=False):
+    stream.write(struct.pack(endian + "IHHIIII", 0xA1B23C4D if nanos else 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
+    for event in events:
+        packet_header = header(event, vlan)
+        seconds, fraction = divmod(EPOCH + event.offset_ns, SECOND)
+        stream.write(struct.pack(endian + "IIII", seconds, fraction if nanos else fraction // 1000,
+                                 len(packet_header), event.length + (18 if vlan else 14)))
+        stream.write(packet_header)
+
+
+def scenarios():
+    def fixture(name, events, end=20, states=None, boundary=None, stop=None):
+        rows = tuple(events)
+        intervals = tuple(QualityInterval(EPOCH + a * SECOND, EPOCH + b * SECOND, state)
+                          for a, b, state in (states or [(0, end, "healthy")]))
+        return Fixture(name, rows, Coverage("synthetic-rspan", "offline-synthetic-only", SUBJECT,
+                       EPOCH, EPOCH + end * SECOND, intervals,
+                       None if boundary is None else EPOCH + boundary * SECOND,
+                       tuple((i, e.duplicate_of) for i, e in enumerate(rows) if e.duplicate_of is not None)),
+                       None if stop is None else EPOCH + stop * SECOND)
+    long = tuple(Transmission(t * SECOND, "upload" if t % 2 else "download", length=1200, transmission_id=t) for t in range(-1, 23))
+    return {
+        "A": fixture("short_completed", [Transmission(SECOND), Transmission(2 * SECOND, "download", length=140)]),
+        "B": fixture("long_lived", long),
+        "C": fixture("idle", []),
+        "D": fixture("burst", [Transmission(SECOND + i * 1000, length=900, transmission_id=i) for i in range(100)]),
+        "E": fixture("active_before_start", long),
+        "F": fixture("ends_after_end", long),
+        "G": fixture("visit_cutover", long, boundary=7),
+        "H": fixture("restart", long, stop=7),
+        "I": fixture("replay", long),
+        "J": fixture("mirror_duplicate", [Transmission(SECOND), Transmission(SECOND, duplicate_of=0)]),
+        "K": fixture("retransmission", [Transmission(SECOND), Transmission(2 * SECOND)]),
+        "L": fixture("capture_quality", [Transmission(SECOND)], states=[(0, 5, "healthy"), (5, 10, "degraded"),
+                                   (10, 15, "source_unavailable"), (15, 20, "prototype_unavailable")]),
+        "M": fixture("ipv4", [Transmission(SECOND, length=60)]),
+        "N": fixture("ipv6", [Transmission(SECOND, ip_version=6, length=1280)]),
+        "O": fixture("upload", [Transmission(SECOND, length=500)]),
+        "P": fixture("download", [Transmission(SECOND, "download", length=750)]),
+    }
