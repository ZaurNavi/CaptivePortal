+    sock = FakeSocket(clock)
+    class DetachmentChecked(Rows):
+        def write(self, row):
+            assert sock.closed
+            super().write(row)
+    rows, result, _, _ = exercise(clock=clock, sock=sock, cfg=config(3), sink=DetachmentChecked(clock))
+    assert len(rows.rows) == 1 and result["capture"]["socket_closed"]
+
+
+def test_live_cli_requires_finite_explicit_arguments_and_uses_only_injected_entry(monkeypatch, tmp_path):
+    from research.dti_00b import __main__, live
+    import sys
+    monkeypatch.setattr(sys, "argv", ["dti", "live", "--interface", "lab0"])
+    with pytest.raises(SystemExit) as missing:
+        __main__.main()
+    assert missing.value.code == 2
+    calls = []
+    def fake_file(cfg, path):
+        calls.append((cfg, path))
+        return {"status": "COMPLETE", "execution_mode": "INJECTED_ONLY"}
+    monkeypatch.setattr(live, "live_to_file", fake_file)
+    monkeypatch.setattr(sys, "argv", ["dti", "live", "--interface", "lab0", "--subject-mac", SUBJECT,
+                                     "--capture-source-id", "fake", "--test-scope", "synthetic", "--duration-seconds", "5",
+                                     "--output", str(tmp_path / "fake.jsonl")])
+    assert __main__.main() == 0
+    assert calls[0][0].duration_seconds == 5 and calls[0][0].interface == "lab0"
+    assert not (tmp_path / "fake.jsonl").exists()
+
+
+@pytest.mark.parametrize("flags,carrier,hardware,ready", [("0x1003", "1", "1", True),
+                                                        ("0x1003", "0", "1", False),
+                                                        ("0x1002", "1", "1", False),
+                                                        ("0x1003", "1", "772", False)])
+def test_readonly_linux_link_probe_uses_admin_up_and_carrier_not_volatile_running_bit(tmp_path, flags, carrier, hardware, ready):
+    root = tmp_path / "lab0"
+    root.mkdir()
+    for name, value in (("flags", flags), ("carrier", carrier), ("type", hardware)):
+        (root / name).write_text(value, encoding="ascii")
+    assert link_ready("lab0", sysfs_root=tmp_path) is ready
