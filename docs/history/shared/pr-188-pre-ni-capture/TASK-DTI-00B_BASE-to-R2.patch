+def exercise(events=(), *, cfg=None, clock=None, sock=None, sink=None, run=RUN1, stop=None, link=None, queue=None):
+    clock = clock or FakeClock()
+    sock = sock or FakeSocket(clock, events)
+    sink = sink or Rows(clock)
+    creations = []
+    def factory(*args):
+        creations.append(args)
+        return sock
+    result = run_live(cfg or config(), sink, clock=clock, run_id=run, stop_event=stop,
+                      platform="linux-test-double", socket_factory=factory,
+                      link_probe=link or (lambda interface: interface == "lab0"),
+                      queue_probe=queue or (lambda source: bool(source.events and source.events[0][0] <= clock.now)))
+    return sink, result, sock, creations
