+++ b/tests/dti_00b/test_meter.py
@@ -0,0 +1,246 @@
+import io
+import struct
+from dataclasses import replace
+
+import pytest
+
+from research.dti_00b.fixtures import EPOCH, SUBJECT, Transmission, header, scenarios, write_pcap
+from research.dti_00b.meter import slices
+from research.dti_00b.model import CADENCE, SECOND, Counters, Coverage, Limits, QualityInterval, instant, replay_relation, semantic_payload
+from research.dti_00b.pcap import CaptureError, read_pcap
+
+RUN1 = "d27fe2da-2031-4f5d-b030-a559d3d8f001"
+RUN2 = "d27fe2da-2031-4f5d-b030-a559d3d8f002"
+ACCOUNTING = ("upload_packets", "download_packets", "upload_bytes_native", "download_bytes_native")
+
+
+def execute(case, *, limits=None, split=False, run=RUN1, endian="<", nanos=True, vlan=False):
+    stream = io.BytesIO()
+    write_pcap(stream, case.events, endian=endian, nanos=nanos, vlan=vlan)
+    stream.seek(0)
+    limits = limits or Limits()
+    counters = Counters()
+    result = list(slices(read_pcap(stream, limits, counters), case.coverage, limits=limits, counters=counters,
+                         run_id=run, stop_at=case.stop_at, split_visit=split))
+    return result, counters
+
+
+@pytest.mark.parametrize("scenario", tuple(scenarios()))
+def test_independent_logical_reference_for_all_sixteen_scenarios(scenario):
+    case = scenarios()[scenario]
+    actual, counters = execute(case)
+    expected = case.reference()
+    assert len(actual) == len(expected)
+    for row, reference in zip(actual, expected):
+        assert instant(row["slice_start_utc"]) == reference["start"]
+        assert instant(row["slice_end_utc"]) == reference["end"]
+        assert {key: row[key] for key in ACCOUNTING} == {key: reference[key] for key in ACCOUNTING}
+        assert instant(row["slice_start_utc"]) % CADENCE == 0
+        assert row["capture_source_id"] == "synthetic-rspan"
+        assert row["subject_key"] == SUBJECT
+    assert counters.raw_packets_seen == len(case.events)
+    assert counters.rejected_packets == 0
+
+
+@pytest.mark.parametrize("endian,nanos", [("<", True), (">", True), ("<", False), (">", False)])
+def test_classic_pcap_endianness_and_timestamp_resolution(endian, nanos):
+    case = replace(scenarios()["M"], events=(Transmission(1_123_456_000, length=60),))
+    rows, _ = execute(case, endian=endian, nanos=nanos)
+    assert rows[0]["first_packet_at"].endswith(".123456000Z")
+    assert rows[0]["upload_bytes_native"] == 60
+
+
+@pytest.mark.parametrize("scenario,expected", [("M", 60), ("N", 1280)])
+def test_header_only_vlan_capture_counts_l3_not_captured_or_ethernet_length(scenario, expected):
+    case = scenarios()[scenario]
+    rows, _ = execute(case, vlan=True)
+    assert rows[0]["upload_bytes_native"] == expected
+    assert len(header(case.events[0], vlan=True)) < expected
+    stream = io.BytesIO()
+    write_pcap(stream, case.events, vlan=True)
+    stream.seek(0)
+    packet = next(read_pcap(stream, Limits(), Counters()))
+    assert packet.src_mac == SUBJECT
+    assert packet.src_ip in ("192.0.2.1", "2001:db8::1")
+    assert packet.protocol == 6
+    assert len(packet.header_identity) <= 82
+
+
+def test_visit_boundary_inside_continuing_flow_exact_conservation():
+    case = scenarios()["G"]
+    whole, _ = execute(case)
+    split, _ = execute(case, split=True)
+    reference = case.reference(split_visit=True)
+    assert len(split) == 5
+    assert instant(split[1]["slice_end_utc"]) == EPOCH + 7 * SECOND
+    assert instant(split[2]["slice_start_utc"]) == EPOCH + 7 * SECOND
+    for key in ACCOUNTING:
+        assert sum(r[key] for r in whole) == sum(r[key] for r in split) == sum(r[key] for r in reference)
+    # Half-open ownership: packet exactly at T belongs only to the following partition.
+    assert split[2]["first_packet_at"].endswith("07.000000000Z")
+
+
+def test_rate_does_not_wait_for_flow_termination_and_idle_is_recent_coverage():
+    rows, _ = execute(scenarios()["B"])
+    assert rows[0]["upload_bytes_per_second"] == 480
+    assert rows[0]["download_bytes_per_second"] == 720
+    burst, _ = execute(scenarios()["D"])
+    assert burst[0]["upload_bytes_per_second"] == 18000
+    assert burst[1]["upload_bytes_per_second"] == 0
+    assert burst[1]["healthy_absence_of_subject_traffic"]
+    assert burst[1]["last_packet_at"] is None
+    assert instant(burst[1]["slice_end_utc"]) == EPOCH + 10 * SECOND
+    # Staleness is derivable from slice_end_utc/quality, no final product policy here.
+
+
+def test_incremental_completed_slice_emitted_before_continuing_flow_ends():
+    case = scenarios()["B"]
+    stream = io.BytesIO()
+    write_pcap(stream, case.events)
+    stream.seek(0)
+    counters = Counters()
+    generator = slices(read_pcap(stream, Limits(), counters), case.coverage, counters=counters, run_id=RUN1)
+    assert next(generator)["complete_accounting"]
+    assert counters.raw_packets_seen < len(case.events)
+
+
+def test_replay_ids_ignore_run_uuid_but_conflicting_accounting_is_not_new_generation():
+    first, _ = execute(scenarios()["I"], run=RUN1)
+    second, _ = execute(scenarios()["I"], run=RUN2)
+    assert first[0]["run_session_id"] != second[0]["run_session_id"]
+    assert [semantic_payload(r) for r in first] == [semantic_payload(r) for r in second]
+    assert all(replay_relation(a, b) == "REPLAY" for a, b in zip(first, second))
+    changed = dict(second[0], upload_bytes_native=999)
+    assert replay_relation(first[0], changed) == "CONFLICT"
+    other = dict(second[0], slice_id="different")
+    assert replay_relation(first[0], other) == "DISTINCT"
+
+
+def test_restart_open_slice_partial_sequence_resets_and_gap_is_unavailable():
+    case = scenarios()["H"]
+    first, _ = execute(case)
+    assert [r["capture_quality_state"] for r in first] == ["healthy", "partial", "prototype_unavailable", "prototype_unavailable"]
+    assert first[1]["upload_bytes_per_second"] is None
+    assert not first[2]["healthy_absence_of_subject_traffic"]
+    restarted = replace(case, coverage=replace(case.coverage, start=EPOCH + 10 * SECOND,
+                         intervals=(QualityInterval(EPOCH + 10 * SECOND, EPOCH + 20 * SECOND, "healthy"),)), stop_at=None)
+    resumed, _ = execute(restarted, run=RUN2)
+    assert resumed[0]["source_sequence"] == 1
+    assert resumed[0]["run_session_id"] != first[0]["run_session_id"]
+    assert replay_relation(first[2], resumed[0]) == "CONFLICT"
+
+
+def test_quality_never_converts_missing_or_degraded_source_to_normal_zero():
+    rows, _ = execute(scenarios()["L"])
+    assert [r["capture_quality_state"] for r in rows] == ["healthy", "degraded", "source_unavailable", "prototype_unavailable"]
+    for row in rows[1:]:
+        assert not row["complete_accounting"]
+        assert not row["healthy_absence_of_subject_traffic"]
+        assert row["upload_bytes_per_second"] is None
+
+
+def test_partial_coverage_edges_are_not_normal_zero():
+    case = scenarios()["C"]
+    coverage = replace(case.coverage, start=EPOCH + SECOND, end=EPOCH + 9 * SECOND,
+                       intervals=(QualityInterval(EPOCH + SECOND, EPOCH + 9 * SECOND, "healthy"),))
+    rows, _ = execute(replace(case, coverage=coverage))
+    assert [r["capture_quality_state"] for r in rows] == ["partial", "partial"]
+    assert all(not r["healthy_absence_of_subject_traffic"] for r in rows)
+
+
+def test_mirror_duplicate_requires_explicit_fixture_provenance_retransmissions_count():
+    rows, counters = execute(scenarios()["J"])
+    assert rows[0]["upload_packets"] == 1
+    assert counters.raw_packets_in_scope == 2
+    assert counters.raw_bytes_native == 200
+    assert counters.duplicate_candidates == counters.deduplicated_packets == 1
+    assert counters.accounted_bytes_native == 100
+    retransmission, counter = execute(scenarios()["K"])
+    assert retransmission[0]["upload_packets"] == 2
+    assert counter.deduplicated_packets == 0
+    # Even indistinguishable timestamp/header packets are NOT suppressed without provenance.
+    unknown = replace(scenarios()["J"], coverage=replace(scenarios()["J"].coverage, duplicate_records=()))
+    retained, counter = execute(unknown)
+    assert retained[0]["upload_packets"] == 2
+    assert counter.deduplicated_packets == 0
+
+
+@pytest.mark.parametrize("limits", [Limits(dedup_horizon_ns=1), Limits(dedup_entries=1)])
+def test_unresolved_duplicate_is_counted_and_degrades_quality_not_silently_lost(limits):
+    case = replace(scenarios()["J"], events=(Transmission(SECOND), Transmission(2 * SECOND, transmission_id=2),
+                                           Transmission(2 * SECOND + 1000, duplicate_of=0)),
+                   coverage=replace(scenarios()["J"].coverage, duplicate_records=((2, 0), (3, 1))))
+    rows, counters = execute(case, limits=limits)
+    assert rows[0]["upload_packets"] == 3
+    assert rows[0]["capture_quality_state"] == "degraded"
+    assert counters.duplicate_provenance_unresolved == 1
+    assert counters.dedup_peak_entries <= limits.dedup_entries
+    assert counters.dedup_evictions >= 1
+
+
+def test_nonmatching_duplicate_claim_never_drops_packet():
+    case = replace(scenarios()["J"], events=(Transmission(SECOND), Transmission(SECOND, length=120, duplicate_of=0)))
+    rows, counters = execute(case)
+    assert rows[0]["upload_bytes_native"] == 220
+    assert rows[0]["capture_quality_state"] == "degraded"
+    assert counters.deduplicated_packets == 0
+
+
+def raw_pcap(frame, original=None):
+    return io.BytesIO(struct.pack("<IHHIIII", 0xA1B23C4D, 2, 4, 0, 0, 65535, 1)
+                      + struct.pack("<IIII", EPOCH // SECOND + 1, 0, len(frame), original or len(frame)) + frame)
+
+
+@pytest.mark.parametrize("frame", [b"bad", header(Transmission(SECOND))[:25],
+                                  header(Transmission(SECOND))[:14] + b"\x40" + b"\0" * 19])
+def test_bad_observed_header_rejects_packet_and_marks_slice_degraded(frame):
+    counters = Counters()
+    rows = list(slices(read_pcap(raw_pcap(frame, 114), Limits(), counters), scenarios()["M"].coverage, counters=counters))
+    assert rows[0]["capture_quality_state"] == "degraded"
+    assert counters.rejected_packets == 1
+    assert not rows[0]["healthy_absence_of_subject_traffic"]
+
+
+@pytest.mark.parametrize("kind", ["multicast", "arp", "unrelated", "ip_multicast"])
+def test_out_of_scope_traffic_is_not_subject_accounting(kind):
+    frame = bytearray(header(Transmission(SECOND)))
+    if kind == "multicast":
+        frame[0] |= 1
+    elif kind == "arp":
+        frame[12:14] = b"\x08\x06"
+    elif kind == "unrelated":
+        frame[11] = 3
+    else:
+        frame[30:34] = bytes([224, 0, 0, 1])
+    counters = Counters()
+    rows = list(slices(read_pcap(raw_pcap(frame, 114), Limits(), counters), scenarios()["M"].coverage, counters=counters))
+    assert counters.out_of_scope_packets == 1
+    assert rows[0]["upload_packets"] == rows[0]["download_packets"] == 0
+
+
+@pytest.mark.parametrize("data", [b"", b"\x0a\x0d\x0d\x0a" + b"\0" * 20,
+                                 struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 101),
+                                 struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1) + b"bad"])
+def test_broken_framing_or_unsupported_input_aborts_not_successful_empty_capture(data):
+    with pytest.raises(CaptureError):
+        list(read_pcap(io.BytesIO(data), Limits(), Counters()))
+
+
+def test_record_limit_and_unsorted_event_time_fail_closed():
+    with pytest.raises(CaptureError, match="record_limit"):
+        execute(scenarios()["K"], limits=Limits(max_records=1))
+    case = replace(scenarios()["K"], events=(Transmission(2 * SECOND), Transmission(SECOND)))
+    with pytest.raises(CaptureError, match="event_time_order"):
+        execute(case)
+
+
+def test_coverage_manifest_closed_partitioned_and_bounded():
+    value = scenarios()["L"].coverage.as_dict()
+    assert Coverage.from_dict(value) == scenarios()["L"].coverage
+    with pytest.raises(ValueError, match="closed"):
+        Coverage.from_dict(dict(value, invented=True))
+    value["capture_quality_intervals"][1]["start_utc"] = value["coverage_start_utc"]
+    with pytest.raises(ValueError, match="partition"):
+        Coverage.from_dict(value)
+    with pytest.raises(ValueError):
+        Limits(dedup_entries=1000000)
