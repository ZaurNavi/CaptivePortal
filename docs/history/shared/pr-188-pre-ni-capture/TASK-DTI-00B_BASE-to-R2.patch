+class FakeClock:
+    def __init__(self):
+        self.now = 0
+        self.wall_offset = 0
+        self.after_sleep = None
+
+    def utc_ns(self):
+        return EPOCH + self.now + self.wall_offset
+
+    def monotonic_ns(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.now += round(seconds * SECOND)
+        if self.after_sleep:
+            self.after_sleep()
+
+
+class FakeSocket:
+    def __init__(self, clock, events=()):
+        self.clock = clock
+        self.events = deque(events)
+        self.options = []
+        self.binding = None
+        self.closed = False
+        self.timeout = 0
+        self.receive_calls = 0
+        self.drop_at = None
+        self.drop_reported = False
+        self.statistics_error = False
+        self.bind_error = False
+        self.timestamp_missing = False
+
+    def setsockopt(self, *arguments):
+        self.options.append(arguments)
+
+    def getsockopt(self, level, option, size=None):
+        if level == SOL_PACKET and option == PACKET_STATISTICS:
+            if self.statistics_error:
+                raise OSError("stats unavailable")
+            drops = 0
+            if self.drop_at is not None and self.clock.now >= self.drop_at and not self.drop_reported:
+                drops, self.drop_reported = 3, True
+            return struct.pack("=II", 0, drops)
+        return 2 * 1024 * 1024 if option == socket.SO_RCVBUF else 0
+
+    def bind(self, address):
+        if self.bind_error:
+            raise OSError("bind failed")
+        self.binding = address
+
+    def settimeout(self, timeout):
+        self.timeout = timeout
+
+    def recvmsg_into(self, buffers, ancillary_size, flags):
+        assert len(buffers) == 1 and len(buffers[0]) == HEADER_BYTES
+        assert ancillary_size == 128
+        assert flags == getattr(socket, "MSG_TRUNC", 0x20)
+        self.receive_calls += 1
+        deadline = self.clock.now + round(self.timeout * SECOND)
+        if not self.events or self.events[0][0] > deadline:
+            self.clock.sleep(self.timeout)
+            raise socket.timeout()
+        event_at, event = self.events.popleft()
+        self.clock.sleep(max(0, event_at - self.clock.now) / SECOND)
+        if isinstance(event, Exception):
+            raise event
+        data = header(event) if isinstance(event, Transmission) else event
+        buffers[0][:len(data)] = data
+        wire_length = event.length + 14 if isinstance(event, Transmission) else len(data)
+        ancillary = [] if self.timestamp_missing else [(socket.SOL_SOCKET, SO_TIMESTAMPNS_NEW,
+                            struct.pack("=qq", (EPOCH + event_at) // SECOND, event_at % SECOND))]
+        return wire_length, ancillary, getattr(socket, "MSG_TRUNC", 0x20), ("lab0", ETH_P_ALL, 3, 1, b"")
+
+    def close(self):
+        self.closed = True
+
+
+class Rows:
+    def __init__(self, clock):
+        self.rows = []
+        self.at = []
+        self.clock = clock
+
+    def write(self, row):
+        self.rows.append(row)
+        self.at.append(self.clock.now)
+
