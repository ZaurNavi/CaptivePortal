@@ -0,0 +1,168 @@
+"""Prototype-only coverage and output contracts; no final DTI schema freeze."""
+
+import hashlib
+import json
+import re
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+from . import VERSION
+
+SECOND = 1_000_000_000
+CADENCE = 5 * SECOND
+QUALITIES = ("healthy", "partial", "degraded", "source_unavailable", "prototype_unavailable")
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def utc(ns):
+    seconds, fraction = divmod(ns, SECOND)
+    return datetime.fromtimestamp(seconds, timezone.utc).strftime("%Y-%m-%dT%H:%M:%S") + f".{fraction:09d}Z"
+
+
+def instant(value):
+    if not isinstance(value, str) or not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,9})?Z", value):
+        raise ValueError("canonical UTC required")
+    head, _, tail = value[:-1].partition(".")
+    seconds = int(datetime.strptime(head, "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp())
+    return seconds * SECOND + int(tail.ljust(9, "0") or "0")
+
+
+@dataclass(frozen=True)
+class QualityInterval:
+    start: int
+    end: int
+    state: str
+
+
+@dataclass(frozen=True)
+class Coverage:
+    capture_source_id: str
+    test_scope: str
+    subject_mac: str
+    start: int
+    end: int
+    intervals: tuple
+    visit_boundary: int = None
+    # Trusted synthetic fixture provenance ONLY: repeated record ordinal -> original.
+    duplicate_records: tuple = ()
+
+    def __post_init__(self):
+        if not all(isinstance(v, str) and 0 < len(v) <= 128 for v in (self.capture_source_id, self.test_scope)):
+            raise ValueError("source/scope required and bounded")
+        if not re.fullmatch(r"(?:[0-9a-f]{2}:){5}[0-9a-f]{2}", self.subject_mac) or int(self.subject_mac[:2], 16) & 1:
+            raise ValueError("canonical unicast subject required")
+        if self.end <= self.start or self.end - self.start > 86400 * SECOND:
+            raise ValueError("coverage must be positive and at most 24 hours")
+        if len(self.intervals) > 4096 or len(self.duplicate_records) > 4096:
+            raise ValueError("manifest bound exceeded")
+        cursor = self.start
+        for interval in self.intervals:
+            if interval.start != cursor or interval.end <= cursor or interval.state not in QUALITIES:
+                raise ValueError("quality intervals must exactly partition coverage")
+            cursor = interval.end
+        if cursor != self.end:
+            raise ValueError("quality coverage incomplete")
+        if self.visit_boundary is not None and not self.start < self.visit_boundary < self.end:
+            raise ValueError("Visit boundary must be inside coverage")
+        seen = set()
+        for repeated, original in self.duplicate_records:
+            if type(repeated) is not int or type(original) is not int or not 0 <= original < repeated or repeated in seen:
+                raise ValueError("invalid duplicate provenance")
+            seen.add(repeated)
+
+    def quality(self, start, end):
+        if start < self.start or end > self.end:
+            return "partial"
+        return max((q.state for q in self.intervals if q.start < end and start < q.end), key=QUALITIES.index)
+
+    def as_dict(self):
+        return dict(capture_source_id=self.capture_source_id, test_scope=self.test_scope,
+                    subject_mac=self.subject_mac, coverage_start_utc=utc(self.start), coverage_end_utc=utc(self.end),
+                    capture_quality_intervals=[dict(start_utc=utc(q.start), end_utc=utc(q.end), state=q.state) for q in self.intervals],
+                    synthetic_visit_boundary_utc=None if self.visit_boundary is None else utc(self.visit_boundary),
+                    synthetic_duplicate_records=[list(pair) for pair in self.duplicate_records])
+
+    @classmethod
+    def from_dict(cls, value):
+        required = {"capture_source_id", "test_scope", "subject_mac", "coverage_start_utc", "coverage_end_utc", "capture_quality_intervals"}
+        if not required <= value.keys() or value.keys() - required - {"synthetic_visit_boundary_utc", "synthetic_duplicate_records"}:
+            raise ValueError("closed coverage manifest")
+        rows = value["capture_quality_intervals"]
+        if not isinstance(rows, list) or len(rows) > 4096:
+            raise ValueError("quality interval limit")
+        intervals = []
+        for row in rows:
+            if set(row) != {"start_utc", "end_utc", "state"}:
+                raise ValueError("closed quality interval")
+            intervals.append(QualityInterval(instant(row["start_utc"]), instant(row["end_utc"]), row["state"]))
+        boundary = value.get("synthetic_visit_boundary_utc")
+        return cls(value["capture_source_id"], value["test_scope"], value["subject_mac"],
+                   instant(value["coverage_start_utc"]), instant(value["coverage_end_utc"]), tuple(intervals),
+                   None if boundary is None else instant(boundary), tuple(tuple(p) for p in value.get("synthetic_duplicate_records", ())))
+
+
+@dataclass(frozen=True)
+class Limits:
+    max_record_bytes: int = 65535
+    max_records: int = 2_000_000
+    dedup_entries: int = 4096
+    dedup_horizon_ns: int = SECOND
+    max_output_bytes: int = 16 * 1024 * 1024
+
+    def __post_init__(self):
+        for name in ("max_record_bytes", "max_records", "dedup_entries", "dedup_horizon_ns", "max_output_bytes"):
+            if type(getattr(self, name)) is not int or getattr(self, name) <= 0:
+                raise ValueError("positive integer limits required")
+        if self.max_record_bytes > 65535 or self.dedup_entries > 4096 or self.max_records > 2_000_000 or self.max_output_bytes > 16 * 1024 * 1024:
+            raise ValueError("prototype hard ceiling exceeded")
+
+
+@dataclass
+class Counters:
+    raw_packets_seen: int = 0
+    raw_packets_in_scope: int = 0
+    raw_bytes_native: int = 0
+    accounted_packets: int = 0
+    accounted_bytes_native: int = 0
+    rejected_packets: int = 0
+    out_of_scope_packets: int = 0
+    outside_coverage_packets: int = 0
+    duplicate_candidates: int = 0
+    deduplicated_packets: int = 0
+    dedup_cache_entries: int = 0
+    dedup_peak_entries: int = 0
+    dedup_evictions: int = 0
+    duplicate_provenance_unresolved: int = 0
+    slices_emitted: int = 0
+    input_buffer_peak_bytes: int = 0
+    queue_peak_records: int = 1
+
+
+def make_slice(coverage, start, end, run_id, sequence, packets, state, reasons):
+    identity = dict(schema_version=1, capture_source_id=coverage.capture_source_id,
+                    test_scope=coverage.test_scope, subject_key=coverage.subject_mac,
+                    slice_start_utc=utc(start), slice_end_utc=utc(end))
+    output = dict(identity, prototype_version=VERSION,
+                  slice_id=hashlib.sha256(canonical(identity).encode()).hexdigest(),
+                  run_session_id=run_id, source_sequence=sequence,
+                  capture_quality_state=state, quality_reasons=sorted(reasons), **packets)
+    complete = state == "healthy"
+    output["complete_accounting"] = complete
+    # Observed counts remain inspectable in incomplete slices, never asserted as zero traffic.
+    output["upload_bytes_per_second"] = packets["upload_bytes_native"] * SECOND / (end - start) if complete else None
+    output["download_bytes_per_second"] = packets["download_bytes_native"] * SECOND / (end - start) if complete else None
+    output["healthy_absence_of_subject_traffic"] = complete and not (packets["upload_packets"] + packets["download_packets"])
+    return output
+
+
+def semantic_payload(slice_value):
+    return {k: v for k, v in slice_value.items() if k not in {"run_session_id", "source_sequence"}}
+
+
+def replay_relation(previous, current):
+    if previous["slice_id"] != current["slice_id"]:
+        return "DISTINCT"
+    return "REPLAY" if semantic_payload(previous) == semantic_payload(current) else "CONFLICT"
