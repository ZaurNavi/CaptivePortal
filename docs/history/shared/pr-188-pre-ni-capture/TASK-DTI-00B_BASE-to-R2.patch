+def test_signal_handlers_only_request_stop_and_are_restored(monkeypatch):
+    handlers = {signal.SIGINT: "previous-int", signal.SIGTERM: "previous-term"}
+    def install(signum, handler):
+        previous = handlers[signum]
+        handlers[signum] = handler
+        return previous
+    monkeypatch.setattr(signal, "signal", install)
+    event = threading.Event()
+    with controlled_signals(event):
+        handlers[signal.SIGTERM](signal.SIGTERM, None)
