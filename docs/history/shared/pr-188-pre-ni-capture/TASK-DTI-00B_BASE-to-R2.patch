+"""Exclusive bounded JSONL output; errors leave a clearly incomplete attempt."""
+
+import hashlib
+import json
+import time
+from dataclasses import asdict
+
+from .meter import slices
+from .model import Limits, Counters, Coverage, canonical
+from .pcap import read_pcap
+
+
+class OutputUnavailable(OSError):
+    pass
+
+
+class BoundedSink:
+    def __init__(self, stream, max_bytes):
+        self.stream = stream
+        self.max_bytes = max_bytes
+        self.bytes_written = 0
+        self.digest = hashlib.sha256()
+
+    def write(self, value):
+        data = (canonical(value) + "\n").encode("utf-8")
+        if self.bytes_written + len(data) > self.max_bytes:
+            raise OutputUnavailable("output_limit_exceeded: prototype_unavailable")
+        try:
+            if self.stream.write(data) != len(data):
+                raise OutputUnavailable("short_output_write: prototype_unavailable")
+            self.stream.flush()
+        except OSError as exc:
+            raise OutputUnavailable("output_unavailable: prototype_unavailable") from exc
+        self.bytes_written += len(data)
+        self.digest.update(data)
+
+
+def load_coverage(path):
+    with open(path, "rb") as stream:
+        raw = stream.read(1024 * 1024 + 1)
+    if len(raw) > 1024 * 1024:
+        raise ValueError("manifest_byte_limit")
+    def unique(pairs):
+        value = {}
+        for key, item in pairs:
+            if key in value:
+                raise ValueError("duplicate_json_key")
+            value[key] = item
+        return value
+    return Coverage.from_dict(json.loads(raw, object_pairs_hook=unique))
+
+
+def replay(input_path, manifest_path, output_path, *, limits=None, run_id=None, split_visit=False):
+    limits = limits or Limits()
+    coverage = load_coverage(manifest_path)
+    counters = Counters()
+    start = time.perf_counter()
+    with open(input_path, "rb") as source, open(output_path, "xb") as target:
+        sink = BoundedSink(target, limits.max_output_bytes)
+        for row in slices(read_pcap(source, limits, counters), coverage, limits=limits, counters=counters,
+                          run_id=run_id, split_visit=split_visit):
+            sink.write(row)
+        return dict(status="COMPLETE", execution_mode="OFFLINE_LAB", counters=asdict(counters),
+                    output_bytes=sink.bytes_written, output_sha256=sink.digest.hexdigest(),
+                    elapsed_seconds=time.perf_counter() - start,
+                    dedup_authority="EXPLICIT_SYNTHETIC_RECORD_PROVENANCE_ONLY",
+                    arbitrary_mirror_dedup_admission="UNRESOLVED", production_access=False)
