index 0000000000000000000000000000000000000000..ae4f281bdc11c82af5a761560d02699af241fffd
--- /dev/null
+++ b/research/dti_00b/live.py
@@ -0,0 +1,261 @@
+"""Timer-driven bounded live orchestration, separate from offline EOF semantics."""
+
+import signal
+import socket
+import threading
+import uuid
+from collections import OrderedDict
+from contextlib import contextmanager
+from dataclasses import asdict
+
+from .live_capture import Clock, LinuxPacketSource, POLL_NS, HEADER_BYTES
+from .meter import account
+from .model import SECOND, CADENCE, Coverage, QualityInterval, Counters, QUALITIES, make_slice, utc
+from .replay import BoundedSink
+
+LIVE_ADAPTER_VERSION = "r2.0"
+
+
+class LiveWindow:
+    def __init__(self, config, start, run_id):
+        self.coverage = Coverage(config.capture_source_id, config.test_scope, config.subject_mac,
+                                 start, start + config.duration_seconds * SECOND,
+                                 (QualityInterval(start, start + config.duration_seconds * SECOND, "healthy"),))
+        self.limits = config.limits
+        self.counters = Counters()
+        self.run_id = run_id
+        self.start = start // CADENCE * CADENCE
+        self.sequence = 0
+        self.sticky_reasons = set()
+        self.all_reasons = set()
+        self.unavailable = False
+        self.late_frames = 0
+        self.unassigned_native_bytes = 0
+        self.last_unassigned_event_utc = None
+        self.reset()
+
+    @property
+    def end(self):
+        return self.start + CADENCE
+
+    def reset(self):
+        self.counts = dict(upload_packets=0, download_packets=0, upload_bytes_native=0,
+                           download_bytes_native=0, first_packet_at=None, last_packet_at=None)
+        self.reasons = set()
+        self.state = "healthy"
+
+    def qualify(self, reason, *, sticky=False, unavailable=False):
+        self.all_reasons.add(reason)
+        (self.sticky_reasons if sticky else self.reasons).add(reason)
+        self.state = max((self.state, "source_unavailable" if unavailable else "degraded"), key=QUALITIES.index)
+        self.unavailable = self.unavailable or unavailable
+
+    def push(self, packet, reasons):
+        self.counters.raw_packets_seen += 1
+        if self.counters.raw_packets_seen > self.limits.max_records:
+            raise OSError("live record limit exceeded")
+        for reason in reasons:
+            self.qualify(reason, sticky=True)
+        if packet.timestamp >= self.coverage.end and self.start >= self.coverage.end:
+            # A receive waking exactly at the finite capture end is out of coverage.
+            self.counters.outside_coverage_packets += 1
+            return
+        if packet.error:
+            self.counters.rejected_packets += 1
+            self.qualify("rejected_header")
+            return
+        if packet.timestamp < self.coverage.start or not self.start <= packet.timestamp < self.end:
+            # Never assign a late/future event to a nearest/current bucket.
+            self.late_frames += 1
+            self.unassigned_native_bytes += packet.native_length
+            self.last_unassigned_event_utc = utc(packet.timestamp)
+            self.counters.outside_coverage_packets += 1
+            self.qualify("event_outside_open_interval", sticky=True)
+            return
+        subject = self.coverage.subject_mac
+        if packet.src_mac == subject and packet.dst_mac != subject:
+            direction = "upload"
+        elif packet.dst_mac == subject and packet.src_mac != subject:
+            direction = "download"
+        else:
+            self.counters.out_of_scope_packets += 1
+            return
+        # Same accepted R1 arithmetic; no provenance map, no heuristic dedup/cache.
+        self.state = account(packet, direction, self.counts, self.state, self.reasons,
+                             self.coverage, self.limits, self.counters, OrderedDict(), {}, set())
+
+    def emit(self, sink, *, final_partial=False):
+        state = self.state
+        reasons = self.reasons | self.sticky_reasons
+        if self.sticky_reasons:
+            state = max((state, "degraded"), key=QUALITIES.index)
+        if self.unavailable:
+            state = "source_unavailable"
+        if (self.start < self.coverage.start or final_partial) and state == "healthy":
+            state = "partial"
+        if self.start < self.coverage.start:
+            reasons.add("adapter_started_inside_interval")
+        if final_partial:
+            reasons.add("adapter_stopped_inside_interval")
+        self.sequence += 1
+        row = make_slice(self.coverage, self.start, self.end, self.run_id, self.sequence,
+                         self.counts, state, reasons)
+        row["mirror_policy"] = "NO_HEURISTIC_DEDUP"
+        row["accounting_qualification"] = "AMBIGUOUS_OBSERVATIONS_COUNTED_NOT_UNIQUE_TRANSMISSIONS"
+        sink.write(row)
+        self.counters.slices_emitted += 1
+        self.start += CADENCE
+        self.reset()
+
+
+def run_live(config, sink, *, clock=None, stop_event=None, run_id=None, socket_factory=socket.socket,
+             platform=None, link_probe=None, queue_probe=None):
+    clock = clock or Clock()
+    stop_event = stop_event or threading.Event()
+    run_id = run_id or str(uuid.uuid4())
+    if str(uuid.UUID(run_id)) != run_id:
+        raise ValueError("canonical run UUID required")
+    options = dict(socket_factory=socket_factory, platform=platform)
+    if link_probe is not None:
+        options["link_probe"] = link_probe
+    if queue_probe is not None:
+        options["queue_probe"] = queue_probe
+    source = LinuxPacketSource(config, clock, **options)
+    open_error = None
+    try:
+        source.open()
+    except OSError as exc:
+        open_error = str(exc)[:256]
+    anchor_mono = clock.monotonic_ns()
+    anchor_utc = clock.utc_ns()
+    window = LiveWindow(config, anchor_utc, run_id)
+    stop_mono = anchor_mono + config.duration_seconds * SECOND
+    next_poll = anchor_mono
+    maximum_delay = maximum_drift = maximum_lag = maximum_write_latency = 0
+    controlled_stop = False
+    if open_error:
+        window.qualify("socket_open_or_bind_failed", sticky=True, unavailable=True)
+
+    def poll(sealing=False):
+        nonlocal next_poll
+        if source.sock is not None:
+            try:
+                for reason in source.health(sealing=sealing):
+                    # Drops cannot be assigned retrospectively to exact sealed buckets.
+                    window.qualify(reason, sticky=True)
+            except OSError:
+                window.qualify("capture_source_failed", sticky=True, unavailable=True)
+                source.close()
+        next_poll = clock.monotonic_ns() + POLL_NS
+
+    def mapped_utc(mono):
+        return anchor_utc + mono - anchor_mono
+
+    def advance(mono):
+        nonlocal maximum_delay, maximum_write_latency
+        while window.end <= min(mapped_utc(mono), window.coverage.end):
+            poll(sealing=True)
+            delay = max(0, mapped_utc(clock.monotonic_ns()) - window.end)
+            maximum_delay = max(maximum_delay, delay)
+            if delay > POLL_NS:
+                window.qualify("slice_emission_delayed", sticky=True)
+            closing_end = window.end
+            before_write = clock.monotonic_ns()
+            window.emit(sink)
+            after_write = clock.monotonic_ns()
+            maximum_write_latency = max(maximum_write_latency, after_write - before_write)
+            maximum_delay = max(maximum_delay, mapped_utc(after_write) - closing_end)
+            if after_write - before_write > POLL_NS:
+                window.qualify("output_backpressure_delay", sticky=True)
+
+    try:
+        while clock.monotonic_ns() < stop_mono and not stop_event.is_set():
+            now = clock.monotonic_ns()
+            drift = abs(clock.utc_ns() - mapped_utc(now))
+            maximum_drift = max(maximum_drift, drift)
+            if drift > POLL_NS:
+                window.qualify("realtime_clock_discontinuity", sticky=True)
+            if now >= next_poll:
+                poll()
+            advance(now)  # Timer completion NEVER waits for another packet.
+            now = clock.monotonic_ns()
+            if now >= stop_mono or stop_event.is_set():
+                break
+            boundary_mono = anchor_mono + window.end - anchor_utc
+            wait_ns = max(1, min(POLL_NS, stop_mono - now, boundary_mono - now))
+            if source.sock is None:
+                clock.sleep(wait_ns / SECOND)
+                continue
+            try:
+                packet, reasons = source.receive(wait_ns / SECOND)
+            except (socket.timeout, InterruptedError):
+                continue
+            except OSError:
+                window.qualify("capture_receive_failed", sticky=True, unavailable=True)
+                source.close()
+                continue
+            mono = clock.monotonic_ns()
+            lag = max(0, mapped_utc(mono) - packet.timestamp)
+            maximum_lag = max(maximum_lag, lag)
+            if lag > POLL_NS:
+                window.qualify("capture_backlog_delay", sticky=True)
+            # At a boundary, account an already received previous-bucket packet first.
+            if packet.timestamp >= window.end:
+                advance(mono)
+            window.push(packet, reasons)
+        controlled_stop = stop_event.is_set()
+        final_mono = min(clock.monotonic_ns(), stop_mono)
+        # Final statistics/queue observation, then detach BEFORE final output flush.
+        poll(sealing=True)
+        source.close()
+        advance(final_mono)
+        if window.start < mapped_utc(final_mono):
+            before_write = clock.monotonic_ns()
+            window.emit(sink, final_partial=True)
+            latency = clock.monotonic_ns() - before_write
+            maximum_write_latency = max(maximum_write_latency, latency)
+            if latency > POLL_NS:
+                window.qualify("output_backpressure_delay", sticky=True)
+    finally:
+        source.close()
+    return dict(status="DEGRADED" if window.all_reasons or window.unavailable else ("STOPPED" if controlled_stop else "COMPLETE"),
+                execution_mode="RESEARCH_LIVE", interface=config.interface, run_session_id=run_id,
+                live_adapter_version=LIVE_ADAPTER_VERSION,
+                adapter_start_utc=utc(anchor_utc), adapter_stop_utc=utc(mapped_utc(clock.monotonic_ns())),
+                accounting_coverage_end_utc=utc(mapped_utc(final_mono)),
+                bounded_duration_seconds=config.duration_seconds, controlled_stop=controlled_stop,
+                open_error=open_error, capture=source.evidence, counters=asdict(window.counters),
+                maximum_realtime_drift_ns=maximum_drift, maximum_slice_emission_delay_ns=maximum_delay,
+                maximum_output_write_latency_ns=maximum_write_latency,
+                maximum_receive_lag_ns=maximum_lag, unassigned_frames=window.late_frames,
+                unassigned_bytes_native=window.unassigned_native_bytes,
+                last_unassigned_event_utc=window.last_unassigned_event_utc,
+                run_quality_reasons=sorted(window.all_reasons),
+                frame_buffer_bound_bytes=HEADER_BYTES, user_packet_queue_bound=0, dedup_cache_entries=0,
+                packet_delivery_model="INDEPENDENT_PACKET_SOCKET_NO_FANOUT_CONFIGURED",
+                packet_stealing_admission="NOT_PROVEN_BY_CODER", production_activation=False)
+
+
+@contextmanager
+def controlled_signals(stop_event):
+    """CLI main thread only; restore handlers, install no persistent state."""
+    previous = {}
+    def stop(signum, frame):
+        stop_event.set()
+    try:
+        for signum in (signal.SIGINT, signal.SIGTERM):
+            previous[signum] = signal.signal(signum, stop)
+        yield
+    finally:
+        for signum, handler in previous.items():
+            signal.signal(signum, handler)
+
+
+def live_to_file(config, output_path):
+    stop_event = threading.Event()
+    # Preflight output BEFORE any packet socket/interface operation.
+    with open(output_path, "xb") as target, controlled_signals(stop_event):
+        sink = BoundedSink(target, config.limits.max_output_bytes)
+        report = run_live(config, sink, stop_event=stop_event)
+        report.update(output_bytes=sink.bytes_written, output_sha256=sink.digest.hexdigest())
+        return report
diff --git a/research/dti_00b/live_capture.py b/research/dti_00b/live_capture.py
