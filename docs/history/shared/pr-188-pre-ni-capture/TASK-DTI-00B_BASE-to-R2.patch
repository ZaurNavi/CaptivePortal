+"""Reproducible offline reconciliation evidence, not independent formal acceptance."""
+
+import hashlib
+import io
+from dataclasses import asdict
+from pathlib import Path
+
+from . import VERSION
+from .fixtures import scenarios, write_pcap
+from .meter import slices
+from .model import Counters, Limits, instant, semantic_payload
+from .pcap import read_pcap
+
+ACCOUNTING = ("upload_packets", "download_packets", "upload_bytes_native", "download_bytes_native")
+
+
+def source_identity():
+    files = {}
+    root = Path(__file__).parent
+    for name in ("__init__.py", "__main__.py", "model.py", "pcap.py", "meter.py", "fixtures.py", "replay.py", "benchmark.py", "admission.py", "live.py", "live_capture.py", "README.md"):
+        files[name] = hashlib.sha256((root / name).read_bytes()).hexdigest()
+    # Identity of the exact source package, excluding generated evidence and pycache.
+    from .model import canonical
+    return dict(version=VERSION, files=files, package_sha256=hashlib.sha256(canonical(files).encode()).hexdigest())
+
+
+def reconciliation():
+    result = []
+    for letter, case in scenarios().items():
+        counters = Counters()
+        pcap = io.BytesIO()
+        write_pcap(pcap, case.events)
+        pcap.seek(0)
+        actual = list(slices(read_pcap(pcap, Limits(), counters), case.coverage, counters=counters,
+                             stop_at=case.stop_at, split_visit=letter == "G"))
+        reference = case.reference(split_visit=letter == "G")
+        equal = len(actual) == len(reference) and all(
+            all(row[k] == truth[k] for k in ACCOUNTING)
+            and instant(row["slice_start_utc"]) == truth["start"]
+            and instant(row["slice_end_utc"]) == truth["end"] for row, truth in zip(actual, reference))
+        result.append(dict(scenario=letter, name=case.name, reference_packets=sum(r["upload_packets"] + r["download_packets"] for r in reference),
+                           meter_packets=sum(r["upload_packets"] + r["download_packets"] for r in actual),
+                           reference_bytes=sum(r["upload_bytes_native"] + r["download_bytes_native"] for r in reference),
+                           meter_bytes=sum(r["upload_bytes_native"] + r["download_bytes_native"] for r in actual),
+                           timing_and_accounting_verdict="PASS" if equal else "FAIL",
+                           quality=[r["capture_quality_state"] for r in actual],
+                           counters=asdict(counters), coverage_manifest=case.coverage.as_dict(),
+                           reference_truth=reference, semantic_slices=[semantic_payload(r) for r in actual]))
+    return dict(task="TASK-DTI-00B", execution_mode="OFFLINE_LAB", source_identity=source_identity(),
+                independent_reference="DECLARED_LOGICAL_TRANSMISSIONS_BEFORE_ENCODING; NOT METER PARSER",
+                scenarios=result, all_sixteen_reconciled=all(r["timing_and_accounting_verdict"] == "PASS" for r in result),
+                arbitrary_mirror_duplicate_admission="PARTIAL: explicit synthetic provenance only; no header heuristic",
+                production_access=False, official_acceptance=False)
