+# NET01 lifecycle-only override; frozen watchdog ExecStart/guard unchanged.
+# All underlying Requires= and After= from frozen service remain in effect.
+[Service]
+ExecStopPost=
+ExecStopPost=+/usr/bin/python3 /usr/local/libexec/captiv-net01/net01-watchdog-stop-post.py
