 .live-table th, .live-table td { padding: .7rem .55rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
 .live-table th { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }
+.live-auth-status[data-auth="authorized"] { color: var(--accent-dark); font-weight: 700; }
