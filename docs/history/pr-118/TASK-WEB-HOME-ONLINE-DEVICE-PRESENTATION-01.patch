+.controller-facts .detail-list dt { white-space: nowrap; }
+.controller-facts .detail-list dd { overflow-wrap: normal; white-space: nowrap; font-weight: 650; }
 
 .login-page { min-height: 100vh; display: grid; place-items: center; padding: 1rem; background: linear-gradient(145deg, #10212d, #174654); }
 .login-card { width: min(420px, 100%); padding: 2rem; border-radius: 18px; background: var(--surface); box-shadow: 0 24px 60px rgba(0, 0, 0, .28); }
