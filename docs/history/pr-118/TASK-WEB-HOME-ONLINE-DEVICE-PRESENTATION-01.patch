+.live-rssi-segment:nth-child(3) { height: 8px; }
+.live-rssi-segment:nth-child(4) { height: 10px; }
+.live-rssi-segment:nth-child(5) { height: 12px; }
+.live-rssi-meter[data-tone="good"] .live-rssi-segment[data-active="true"] { background: var(--accent); }
+.live-rssi-meter[data-tone="warning"] .live-rssi-segment[data-active="true"] { background: var(--warning); }
+.live-rssi-meter[data-tone="danger"] .live-rssi-segment[data-active="true"] { background: var(--danger); }
