index a3d04e6a1be49242f87cf1d6b0bc0cebc5db56c2..97e3a6d60435b897bef6077230df626dd3d7f694 100644
--- a/app/admin_web/static/admin.css
+++ b/app/admin_web/static/admin.css
@@ -397,3 +397,44 @@ input[type="radio"] { width: auto; min-height: 0; }
 .feature-settings-details { display: grid; grid-template-columns: minmax(8rem, 1fr) minmax(0, 2fr); gap: .35rem 1rem; }
 .feature-settings-details dd { margin: 0; overflow-wrap: anywhere; }
 @media (max-width: 600px) { .feature-settings-details { grid-template-columns: 1fr; } }
+
+/* NI-03 presentation only; other cards and grids retain their styles. */
+#device-protocol-intelligence { min-width: 0; margin-top: 1.25rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow-wrap: anywhere; }
+#device-protocol-intelligence .section-heading { margin: 0 0 .85rem; }
+#device-protocol-intelligence .section-heading > div { min-width: 0; }
+#device-protocol-intelligence .section-heading h2 { font-size: 1.2rem; line-height: 1.35; }
+#device-protocol-intelligence .section-heading p { margin: .35rem 0 0; color: var(--muted); font-size: .85rem; }
+#device-protocol-intelligence #device-protocol-refresh { flex-shrink: 0; }
+#device-protocol-intelligence .state-panel { padding: .65rem .8rem; font-size: .85rem; }
+#device-protocol-intelligence .state-panel > div { min-width: 0; }
+#device-protocol-intelligence .state-panel p { line-height: 1.45; }
+#device-protocol-intelligence .protocol-info-card { grid-column: span 4; padding: .9rem 1rem; background: var(--surface-soft); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: none; }
+#device-protocol-intelligence .protocol-info-card--recent { grid-column: 1 / -1; }
+#device-protocol-intelligence .protocol-info-card--last,
+#device-protocol-intelligence .protocol-info-card--freshness { grid-column: span 6; }
+#device-protocol-intelligence .protocol-info-label { font-size: .75rem; font-weight: 750; color: var(--muted); }
+#device-protocol-intelligence .protocol-info-value { margin: .45rem 0 0; font-size: .95rem; font-weight: 650; }
+#device-protocol-intelligence .protocol-chip-list { display: flex; flex-wrap: wrap; gap: .5rem; }
+#device-protocol-intelligence .protocol-chip { display: inline-flex; align-items: center; flex-wrap: wrap; min-width: 0; max-width: 100%; gap: .5rem; padding: .45rem .7rem; background: var(--surface); border: 1px solid var(--line); border-radius: 9px; }
+#device-protocol-intelligence .protocol-chip strong { font-weight: 700; }
+#device-protocol-intelligence .protocol-chip time { font-size: .75rem; font-weight: 400; color: var(--muted); }
+#device-protocol-intelligence .protocol-observation { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
+#device-protocol-intelligence .protocol-status { display: inline-flex; max-width: 100%; border-radius: 999px; padding: .25rem .6rem; font-size: .8rem; font-weight: 750; }
+#device-protocol-intelligence .protocol-status[data-state="usable"],
+#device-protocol-intelligence .protocol-status[data-state="fresh"] { background: #d9f3ef; color: #24514f; }
+#device-protocol-intelligence .protocol-status[data-state="recent"] { background: #e7f1ff; color: #175cd3; }
+#device-protocol-intelligence .protocol-status[data-state="degraded"],
+#device-protocol-intelligence .protocol-status[data-state="stale"] { background: #fef0c7; color: #734c00; }
+#device-protocol-intelligence .protocol-status[data-state="unavailable"] { background: #fee4e2; color: #7a271a; }
+#device-protocol-intelligence .protocol-status[data-state="unknown"] { background: #eef2f4; color: #667482; }
+@media (max-width: 820px) {
+  #device-protocol-intelligence .protocol-info-card { grid-column: span 6; }
+  #device-protocol-intelligence .protocol-info-card--recent { grid-column: 1 / -1; }
+}
+@media (max-width: 560px) {
+  #device-protocol-intelligence .section-heading { flex-direction: column; }
+  #device-protocol-intelligence .protocol-chip-list { flex-direction: column; align-items: flex-start; }
+  #device-protocol-intelligence .protocol-info-card,
+  #device-protocol-intelligence .protocol-info-card--last,
+  #device-protocol-intelligence .protocol-info-card--freshness { grid-column: 1 / -1; }
+}
